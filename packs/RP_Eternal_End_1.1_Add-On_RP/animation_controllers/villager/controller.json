{"format_version":"1.10.0","animation_controllers":{"controller.animation.panascais_end.villager.controller":{"initial_state":"default","states":{"default":{"on_entry":["v.health = q.health;"],"blend_transition":0.2,"animations":[{"idle_unemployed":"v.profession == 'unemployed'"},{"idle_farmer":"v.profession == 'farmer'"},{"idle_cleric":"v.profession == 'cleric'"},{"idle_armorer":"v.profession == 'armorer'"},{"idle_weaponsmith":"v.profession == 'weaponsmith'"},{"idle_toolsmith":"v.profession == 'toolsmith'"},{"idle_butcher":"v.profession == 'butcher'"},{"idle_stone_mason":"v.profession == 'stone_mason'"},{"idle_guard":"v.profession == 'idle_guard'"}],"transitions":[{"walk":"q.modified_move_speed >= 0.1"},{"attack":"q.is_delayed_attacking"},{"hurt":"v.health = q.health > v.health ? q.health : v.health; return q.health < v.health;"}],"blend_via_shortest_path":true},"walk":{"on_entry":["v.health = q.health;"],"blend_transition":0.2,"animations":[{"walk":"variable.walk_multiplier * query.modified_move_speed"}],"transitions":[{"default":"q.modified_move_speed < 0.1"},{"attack":"q.is_delayed_attacking"},{"hurt":"v.health = q.health > v.health ? q.health : v.health; return q.health < v.health;"}],"blend_via_shortest_path":true},"attack":{"on_entry":["v.health = q.health;"],"blend_transition":0.2,"animations":[{"walk":"query.modified_move_speed"},"attack"],"transitions":[{"walk":"q.all_animations_finished && q.modified_move_speed >= 0.1"},{"default":"q.all_animations_finished"},{"hurt":"v.health = q.health > v.health ? q.health : v.health; return q.health < v.health;"}],"blend_via_shortest_path":true},"hurt":{"blend_transition":0.2,"animations":["hurt",{"walk":"variable.walk_multiplier * query.modified_move_speed"}],"transitions":[{"walk":"q.modified_move_speed >= 0.1 && q.any_animation_finished"},{"default":"q.any_animation_finished"}],"blend_via_shortest_path":true}}}}}