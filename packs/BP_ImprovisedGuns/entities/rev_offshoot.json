{
  "format_version": "1.21.0",
  "minecraft:entity": {
    "description": {
      "identifier": "rev:offshoot",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "rev:load_stage": {
          "type": "int",
          "client_sync": true,
          "default": 1,
          "range": [
            1,
            5
          ]
        },
        "rev:weapon_type": {
          "type": "int",
          "client_sync": true,
          "default": 0,
          "range": [
            0,
            3
          ]
        }
      }
    },
    "component_groups": {
      "rev:deny_shoot": {
        "minecraft:shooter": {
          "def": ""
        }
      },
      "rev:weapon_loaded_0": {
        "minecraft:shooter": {
          "def": "rev:flintlock_bullet"
        }
      },
      "rev:weapon_loaded_1": {
        "minecraft:shooter": {
          "def": "rev:musket_bullet"
        }
      },
      "rev:weapon_loaded_2": {
        "minecraft:shooter": {
          "def": "rev:mauler_bullet"
        }
      },
      "rev:weapon_loaded_3": {
        "minecraft:shooter": {
          "def": "rev:musket_bullet_hunting"
        }
      }
    },
    "components": {
      "minecraft:experience_reward": {
        "on_death": "query.last_hit_by_player ? 5 + (query.equipment_count * Math.Random(1,3)) : 0"
      },
      "minecraft:loot": {
        "table": "loot_tables/entities/offshoot.json"
      },
      "minecraft:behavior.ranged_attack": {
        "priority": 0,
        "attack_interval_min": 1,
        "attack_radius_min": 3,
        "speed_multiplier": 1.3,
        "attack_interval_max": 2,
        "attack_radius": 15
      },
      "minecraft:timer": {
        "time": 0.5,
        "looping": true,
        "time_down_event": {
          "event": "rev:start_loading",
          "target": "self"
        }
      },
      "minecraft:collision_box": {
        "width": 0.6,
        "height": 1.9
      },
      "minecraft:type_family": {
        "family": [
          "skeleton",
          "undead",
          "monster",
          "mob"
        ]
      },
      "minecraft:breathable": {
        "total_supply": 15,
        "suffocate_time": 0,
        "breathes_water": true
      },
      "minecraft:health": {
        "value": 15,
        "max": 15
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "filters": {
              "test": "in_lava",
              "subject": "self",
              "operator": "==",
              "value": true
            },
            "cause": "lava",
            "damage_per_tick": 4
          }
        ]
      },
      "minecraft:burns_in_daylight": {},
      "minecraft:movement": {
        "value": 0.3
      },
      "minecraft:navigation.walk": {
        "is_amphibious": true,
        "avoid_sun": true,
        "avoid_water": true
      },
      "minecraft:movement.basic": {},
      "minecraft:jump.static": {},
      "minecraft:can_climb": {},
      "minecraft:nameable": {},
      "minecraft:despawn": {
        "despawn_from_distance": {}
      },
      "minecraft:behavior.hurt_by_target": {
        "priority": 1
      },
      "minecraft:behavior.nearest_attackable_target": {
        "priority": 2,
        "must_see": true,
        "reselect_targets": true,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "player"
            },
            "max_dist": 16
          },
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "iron_golem"
            },
            "max_dist": 16
          },
          {
            "filters": {
              "all_of": [
                {
                  "test": "is_family",
                  "subject": "other",
                  "value": "baby_turtle"
                },
                {
                  "test": "in_water",
                  "subject": "other",
                  "operator": "!=",
                  "value": true
                }
              ]
            },
            "max_dist": 16
          }
        ]
      },
      "minecraft:behavior.avoid_mob_type": {
        "priority": 4,
        "entity_types": [
          {
            "filters": {
              "test": "is_family",
              "subject": "other",
              "value": "wolf"
            },
            "max_dist": 6,
            "walk_speed_multiplier": 1.2,
            "sprint_speed_multiplier": 1.2
          }
        ]
      },
      "minecraft:behavior.random_stroll": {
        "priority": 6,
        "speed_multiplier": 1
      },
      "minecraft:behavior.look_at_player": {
        "priority": 7,
        "look_distance": 8
      },
      "minecraft:behavior.random_look_around": {
        "priority": 8
      },
      "minecraft:physics": {},
      "minecraft:pushable": {
        "is_pushable": true,
        "is_pushable_by_piston": true
      },
      "minecraft:conditional_bandwidth_optimization": {}
    },
    "events": {
      "rev:start_loading": {
        "sequence": [
          {
            "filters": [
              {
                "test": "has_target",
                "subject": "self",
                "value": true
              },
              {
                "test": "int_property",
                "subject": "self",
                "domain": "rev:load_stage",
                "value": 5
              }
            ],
            "queue_command": {
              "command": "playsound crossbow.loading.end @a ~ ~ ~ "
            },
            "sequence": [
              {
                "trigger": "rev:end_reload"
              }
            ]
          },
          {
            "filters": [
              {
                "test": "has_target",
                "subject": "self",
                "value": true
              },
              {
                "test": "int_property",
                "subject": "self",
                "domain": "rev:load_stage",
                "value": 4
              }
            ],
            "set_property": {
              "rev:load_stage": 5
            }
          },
          {
            "filters": [
              {
                "test": "has_target",
                "subject": "self",
                "value": true
              },
              {
                "test": "int_property",
                "subject": "self",
                "domain": "rev:load_stage",
                "value": 3
              }
            ],
            "set_property": {
              "rev:load_stage": 4
            }
          },
          {
            "filters": [
              {
                "test": "has_target",
                "subject": "self",
                "value": true
              },
              {
                "test": "int_property",
                "subject": "self",
                "domain": "rev:load_stage",
                "value": 2
              }
            ],
            "queue_command": {
              "command": "playsound crossbow.loading.start @a ~ ~ ~ "
            },
            "set_property": {
              "rev:load_stage": 3
            }
          },
          {
            "filters": [
              {
                "test": "has_target",
                "subject": "self",
                "value": true
              },
              {
                "test": "int_property",
                "subject": "self",
                "operator": "==",
                "domain": "rev:load_stage",
                "value": 1
              }
            ],
            "set_property": {
              "rev:load_stage": 2
            }
          }
        ]
      },
      "minecraft:entity_spawned": {
        "sequence": [
          {
            "add": {
              "component_groups": [
                "rev:deny_shoot"
              ]
            }
          },
          {
            "randomize": [
              {
                "weight": 10,
                "set_property": {
                  "rev:weapon_type": 0
                },
                "queue_command": {
                  "command": "replaceitem entity @s slot.weapon.mainhand 0 rev:flintlock"
                }
              },
              {
                "weight": 3,
                "set_property": {
                  "rev:weapon_type": 1
                },
                "queue_command": {
                  "command": "replaceitem entity @s slot.weapon.mainhand 0 rev:musket"
                }
              },
              {
                "weight": 3,
                "set_property": {
                  "rev:weapon_type": 2
                },
                "queue_command": {
                  "command": "replaceitem entity @s slot.weapon.mainhand 0 rev:mauler"
                }
              },
              {
                "weight": 1,
                "set_property": {
                  "rev:weapon_type": 3
                },
                "queue_command": {
                  "command": "replaceitem entity @s slot.weapon.mainhand 0 rev:hunting_musket"
                }
              }
            ]
          }
        ]
      },
      "rev:start_reload": {
        "sequence": [
          {
            "set_property": {
              "rev:load_stage": 1
            }
          },
          {
            "remove": {
              "component_groups": [
                "rev:weapon_loaded_0",
                "rev:weapon_loaded_1",
                "rev:weapon_loaded_2",
                "rev:weapon_loaded_3"
              ]
            },
            "add": {
              "component_groups": [
                "rev:deny_shoot"
              ]
            }
          }
        ]
      },
      "rev:end_reload": {
        "sequence": [
          {
            "remove": {
              "component_groups": [
                "rev:deny_shoot"
              ]
            }
          },
          {
            "filters": {
              "test": "int_property",
              "domain": "rev:weapon_type",
              "value": 0
            },
            "add": {
              "component_groups": [
                "rev:weapon_loaded_0"
              ]
            }
          },
          {
            "filters": {
              "test": "int_property",
              "domain": "rev:weapon_type",
              "value": 1
            },
            "add": {
              "component_groups": [
                "rev:weapon_loaded_1"
              ]
            }
          },
          {
            "filters": {
              "test": "int_property",
              "domain": "rev:weapon_type",
              "value": 2
            },
            "add": {
              "component_groups": [
                "rev:weapon_loaded_2"
              ]
            }
          },
          {
            "filters": {
              "test": "int_property",
              "domain": "rev:weapon_type",
              "value": 3
            },
            "add": {
              "component_groups": [
                "rev:weapon_loaded_3"
              ]
            }
          }
        ]
      }
    }
  }
}