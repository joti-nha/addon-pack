{
	"format_version": "1.21.30",
	"minecraft:entity": {
		"description": {
			"identifier": "rev:crooked_mortar_bullet",
			"is_spawnable": false,
			"is_summonable": true,
			"runtime_identifier": "snowball",
			"is_experimental": false
		},
		"component_groups": {
			"rev:explode": {
				"minecraft:explode": {
					"fuse_length": -1,
					"fuse_lit": true,
					"power": 4.2,
					"breaks_blocks": true,
					"causes_fire": false,
					"destroy_affected_by_griefing": true
				}
			}
		},
		"components": {
			"minecraft:collision_box": {
				"width": 0.7,
				"height": 0.7
			},
			"minecraft:type_family": {
				"family": [
					"rev_improvised_bullet"
				]
			},
			"minecraft:projectile": {
				"on_hit": {
					"impact_damage": {
						"damage": 0,
						"knockback": false
					},
					"definition_event": {
						"event_trigger": {
							"event": "rev:hit"
						}
					},
					"particle_on_hit": {
						"particle_type": "explode",
						"num_particles": 30,
						"on_entity_hit": true,
						"on_other_hit": true
					}
				},
				"anchor": 1,
				"power": 3,
				"gravity": 0.1,
				"angle_offset": 0
			},
			"minecraft:scale": {
				"value": 1
			},
			"minecraft:timer": {
				"looping": true,
				"time": 4,
				"time_down_event": {
					"event": "rev:hit"
				}
			},
			"minecraft:physics": {},
			"minecraft:pushable": {
				"is_pushable": true,
				"is_pushable_by_piston": true
			}
		},
		"events": {
			"rev:die": {
				"queue_command": {
					"command": "kill @s"
				}
			},
			"rev:hit": {
				"sequence": [
				
					{
						"add": {
							"component_groups": [
								"rev:explode"
							]
						}
					}
				]
			}
		}
	}
}