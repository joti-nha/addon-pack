				"reload_controller": "controller.animation.auto_gun.reload",
				"default": "animation.player.ajolote.third2",
				"specific": "animation.auto_gun.specific",
				"start": "animation.auto_gun.start",
				"fire_controller": "controller.animation.musket.fire",
				"fire_controller_empty": "controller.animation.empty.fire",
				"fire": "animation.auto_gun.shoot",
				"fire_off": "animation.auto_gun.shoot.off",
				"first_person_spear": "animation.player.ajolote.first_person_spear"
			},
			"scripts": {
				"animate": [
					{
						"specific": "c.is_first_person"
					},
					{
						"reload_controller": "c.is_first_person"
					},
					{
						"first_person": "c.is_first_person"
					},
					
					{
						"fire_controller": "c.is_first_person"
					},
					{
						"default": "!c.is_first_person"
					}
				]
			},
			"render_controllers": [
				"controller.render.item_default"
			]
		}
