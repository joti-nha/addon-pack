{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": {
			"identifier": "rev:shadow_auto_gun",
			"materials": {
				"default": "entity_alphatest",
				"enchanted": "entity_alphatest_glint"
			},
			"textures": {
				"default": "textures/models/auto_gun_texture",
				"enchanted": "textures/models/rev_glint"
			},
			"geometry": {
				"default": "geometry.auto_gun"
			},
			"sound_effects": {
				"open": "open.wooden_trapdoor",
				"reload": "block.barrel.close",
				"close": "close.wooden_trapdoor",
				"pull": "mob.witch.throw",
				"flick": "close.wooden_trapdoor"
			},
			"animations": {
				"first_person": "animation.player.ajolote.first_person",
