{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "rev:offshoot",
      "min_engine_version": "1.8.0",
      "materials": {
        "default": "enderman"
      },
      "textures": {
        "default": "textures/entity/rev_offshoot"
      },
      "geometry": {
        "default": "geometry.rev_offshoot"
      },
      "spawn_egg": {
        "texture": "offshoot_spawn_egg"
      },
      "scripts": {
        "pre_animation": [
          "variable.tcos0 = (Math.cos(query.modified_distance_moved * 38.17) * query.modified_move_speed / variable.gliding_speed_value) * 57.3;"
        ],
        "animate": [
          "look_at_target",
          "bob_controller",
          {
            "move": "!query.has_target"
          },
          {
            "move_target": "query.has_target"
          },
          {
            "loading": "query.property('rev:load_stage') != 5 && query.has_target"
          },
          {
            "loaded": "query.property('rev:load_stage') == 5 && query.has_target"
          }
        ]
      },
      "animations": {
        "look_at_target": "controller.animation.humanoid.look_at_target",
        "look_at_target_default": "animation.humanoid.look_at_target.default",
        "look_at_target_gliding": "animation.humanoid.look_at_target.gliding",
        "look_at_target_swimming": "animation.humanoid.look_at_target.swimming",
        "move": "animation.rev_offshoot.walk",
        "move_target": "animation.rev_offshoot.walk_target",
        "bob_controller": "controller.animation.humanoid.bob",
        "bow_and_arrow_controller": "controller.animation.humanoid.bow_and_arrow",
        "riding": "controller.animation.humanoid.riding",
        "riding.arms": "animation.humanoid.riding.arms",
        "riding.legs": "animation.humanoid.riding.legs",
        "holding": "animation.humanoid.holding",
        "brandish_spear": "animation.humanoid.brandish_spear",
        "charging": "animation.humanoid.charging",
        "attack.rotations": "animation.humanoid.attack.rotations",
        "sneaking": "animation.humanoid.sneaking",
        "bob": "animation.humanoid.bob",
        "damage_nearby_mobs": "animation.humanoid.damage_nearby_mobs",
        "bow_and_arrow": "animation.humanoid.bow_and_arrow",
        "swimming": "animation.zombie.swimming",
        "use_item_progress": "animation.humanoid.use_item_progress",
        "skeleton_attack": "animation.skeleton.attack",
        "attack": "controller.animation.humanoid.attack",
        "loading": "animation.rev_offshoot.loading_single",
        "loaded": "animation.rev_offshoot.loaded_single"
      },
      "render_controllers": [
        "controller.render.default"
      ],
      "enable_attachables": true
    }
  }
}
