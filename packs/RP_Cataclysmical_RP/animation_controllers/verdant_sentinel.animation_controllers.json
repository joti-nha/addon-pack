{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.verdant_sentinel.move_controller": {
			"initial_state": "idle",
			"states": {
				"unconscious": {
					"animations": [
						"unconscious"
					],
					"transitions": [
						{
							"awaken": "query.is_stunned&&query.skin_id==1"
						},
						{
							"death": "q.property('mnra_cata:attack_test')==10&&query.skin_id==10"
						}
					],
					"blend_transition": 0.3
				},
				"awaken": {
					"animations": [
						"awaken"
					],
					"transitions": [
						{
							"idle": "query.all_animations_finished"
						},
						{
							"move": "query.all_animations_finished"
						},
						{
							"unconscious": "query.is_stunned&&query.skin_id==0"
						},
						{
							"death": "q.property('mnra_cata:attack_test')==10&&query.skin_id==10"
						}
					],
					"blend_transition": 0.4
				},
				"idle": {
					"animations": [
						"idle"
					],
					"transitions": [
						{
							"move": "q.ground_speed>0.1"
						},
						{
							"unconscious": "query.is_stunned&&query.skin_id==0"
						},
						{
							"death": "q.property('mnra_cata:attack_test')==10&&query.skin_id==10"
						}
					],
					"blend_transition": 0.4
				},
				"move": {
					"animations": [
						"move"
					],
					"transitions": [
						{
							"idle": "q.ground_speed<0.1"
						},
						{
							"unconscious": "query.is_stunned&&query.skin_id==0"
						},
						{
							"death": "q.property('mnra_cata:attack_test')==10&&query.skin_id==10"
						}
					],
					"blend_transition": 0.4
				},
				"death": {
					"blend_transition": false
				}
			}
		},
		"controller.animation.verdant_sentinel.attack_controller": {
			"states": {
				"default": {
					"transitions": [
						{
							"normal_attack": "q.property('mnra_cata:attack_test')==3&&query.skin_id==3"
						},
						{
							"double_attack": "q.property('mnra_cata:attack_test')==4&&query.skin_id==4"
						},
						{
							"heavy_attack": "q.property('mnra_cata:attack_test')==5&&query.skin_id==5"
						},
						{
							"move_attack": "q.property('mnra_cata:attack_test')==6&&query.skin_id==6"
						},
						{
							"dash_attack": "q.property('mnra_cata:attack_test')==7&&query.skin_id==7"
						},
						{
							"stomp_attack": "q.property('mnra_cata:attack_test')==8&&query.skin_id==8"
						},
						{
							"death": "query.health==1"
						}
					],
					"blend_transition": 0.4
				},
				"normal_attack": {
					"animations": [
						"normal_attack"
					],
					"transitions": [
						{
							"default": "q.property('mnra_cata:attack_test')==0"
						},
						{
							"death": "query.health==1"
						}
					],
					"blend_transition": 0.4
				},
				"double_attack": {
					"animations": [
						"double_attack"
					],
					"transitions": [
						{
							"default": "q.property('mnra_cata:attack_test')==0"
						},
						{
							"death": "query.health==1"
						}
					],
					"blend_transition": 0.4
				},
				"heavy_attack": {
					"animations": [
						"heavy_attack"
					],
					"transitions": [
						{
							"default": "q.property('mnra_cata:attack_test')==0"
						},
						{
							"death": "query.health==1"
						}
					],
					"blend_transition": 0.4
				},
				"move_attack": {
					"animations": [
						"move_attack"
					],
					"transitions": [
						{
							"default": "q.property('mnra_cata:attack_test')==0"
						},
						{
							"death": "query.health==1"
						}
					],
					"blend_transition": 0.4
				},
				"dash_attack": {
					"animations": [
						"dash_attack"
					],
					"transitions": [
						{
							"default": "q.property('mnra_cata:attack_test')==0"
						},
						{
							"death": "query.health==1"
						}
					],
					"blend_transition": 0.4
				},
				"stomp_attack": {
					"animations": [
						"stomp_attack"
					],
					"transitions": [
						{
							"default": "q.property('mnra_cata:attack_test')==0"
						},
						{
							"death": "query.health==1"
						}
					],
					"blend_transition": 0.4
				},
				"death": {
					"animations": [
						"death"
					]
				}
			}
		},
		"controller.animation.verdant_sentinel.stance_controller": {
			"states": {
				"default": {
					"transitions": [
						{
							"stance": "!query.is_delayed_attacking&&!query.is_casting&&!query.is_stunned&&q.property('mnra_cata:attack_test')==0"
						}
					],
					"blend_transition": 0.4
				},
				"stance": {
					"animations": [
						"stance"
					],
					"transitions": [
						{
							"default": "query.is_delayed_attacking||query.is_casting||query.is_stunned||!q.property('mnra_cata:attack_test')==0"
						}
					],
					"blend_transition": 0.2
				}
			}
		}
	}
}