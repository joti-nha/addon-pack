{"format_version":"1.10.0","animation_controllers":{"controller.animation.panascais_end.gilded_golem.movement":{"initial_state":"statue","states":{"statue":{"animations":["statue"],"transitions":[{"idle":"q.variant == 1"}],"blend_transition":0.3},"idle":{"animations":["idle",{"walk":"variable.walk_multiplier * query.modified_move_speed"}],"transitions":[{"statue":"q.variant != 1"},{"attack_melee":"q.is_delayed_attacking"},{"attack_range":"q.is_charged > 0"}],"blend_transition":0.3},"attack_melee":{"animations":["attack_melee",{"walk":"query.modified_move_speed"}],"transitions":[{"idle":"query.all_animations_finished"}],"blend_transition":0.3},"attack_range":{"animations":["attack_range",{"walk":"query.modified_move_speed"}],"transitions":[{"idle":"q.is_charged <= 0"}],"blend_transition":0.3}}},"controller.animation.panascais_end.gilded_golem.particles":{"states":{"default":{"particle_effects":[{"effect":"golem_dust","locator":"head_locator"}]}}}}}