{
   "namespace": "hud",

   "hud_title_text/title_frame/title": {
      "modifications": [
         {
            "array_name": "bindings",
            "operation": "insert_back",
            "value": {
               "binding_type": "view",
               "source_property_name": "(not (('%.1s' * #text) = '!'))",
               "target_property_name": "#visible"
            }
         }
      ]
   },

   "hud_actionbar_text": {
      "$atext": "$actionbar_text",
      "visible": "(not (('%.1s' * $atext) = '!'))"
   },

   "root_panel": {
      "modifications": [
         {
            "array_name": "controls",
            "operation": "insert_back",
            "value": [
               {
                  "coldown_element": {
                     "type": "panel",
                     "size": ["16px", "16px"],
                     "controls": [{ "cooldown_panel@javacombat.cooldown_panel": {} }]
                  }
               }
            ]
         }
      ]
   },
   "anim_title_background_alpha_in": {
      "anim_type": "alpha",
      "easing": "linear",
      "duration": "$title_fade_in_time",
      "from": 0,
      "to": 0,
      "next": "@hud.anim_title_background_alpha_stay"
   },
   "anim_actionbar_text_background_alpha_out": {
      "anim_type": "alpha",
      "easing": "in_expo",
      "duration": 3,
      "from": 0,
      "to": 0,
      "destroy_at_end": "hud_actionbar_text",
      "end_event": "hud_actionbar_text_complete"
   }
}
