{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.entity.ntk_dire_bat": {
      "geometry": "query.is_baby ? Geometry.baby : Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "query.is_baby ? Array.textures_baby[query.variant * 2 + query.is_tamed] : Array.textures_adult[query.variant * 2 + query.is_tamed]"
      ],
      "arrays": {
				"textures": {
          "Array.textures_adult": [
						"Texture.dire_bat_wild",
						"Texture.dire_bat_tamed"
          ],
          "Array.textures_baby": [
            "Texture.dire_bat_baby_wild",
            "Texture.dire_bat_baby_tamed"
          ]
        }
			}
    }
  }
}
