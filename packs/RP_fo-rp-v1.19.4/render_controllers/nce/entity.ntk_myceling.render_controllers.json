{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.entity.ntk_myceling": {
      "geometry": "Geometry.default",
      "part_visibility": [
        {
          "back": "!query.is_baby"
        }
      ],
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
				"Array.textures[query.is_sleeping ? 0 : (query.is_tamed ? 2 : 1)]"
			],
			"arrays": {
				"textures": {
					"Array.textures": [
						"Texture.myceling_sleeping",
						"Texture.myceling_wild",
						"Texture.myceling_tamed"
					]
				}
			}
    }
  }
}
