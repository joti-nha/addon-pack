{
  "format_version": "1.26.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "ntk:dire_bat",
      "enable_attachables": false,
      "hide_armor": false,
      "spawn_egg": {
        "texture": "ntk_spawn_egg_dire_bat"
      },
      "render_controllers": [
        "controller.render.entity.ntk_dire_bat"
      ],
      "geometry": {
        "default": "geometry.entity.ntk_dire_bat",
        "baby": "geometry.entity.ntk_dire_bat_baby"
      },
      "materials": {
        "default": "ntk_entity_emissive_alpha"
      },
      "textures": {
        "dire_bat_wild": "textures/entity/nm/dire_bat/ntk_dire_bat_wild",
        "dire_bat_tamed": "textures/entity/nm/dire_bat/ntk_dire_bat_tamed",
        "dire_bat_baby_wild": "textures/entity/nm/dire_bat/ntk_dire_bat_baby_wild",
        "dire_bat_baby_tamed": "textures/entity/nm/dire_bat/ntk_dire_bat_baby_tamed"
      },
      "animations": {
        "controller_attack": "controller.animation.entity.ntk_dire_bat.attack",
        "controller_interested": "controller.animation.entity.ntk_dire_bat.interested",
        "controller_movement": "controller.animation.entity.ntk_dire_bat.movement",
        "baby_remodel": "animation.entity.ntk_dire_bat.baby_remodel",
        "bite_attack": "animation.entity.ntk_dire_bat.bite_attack",
        "flying": "animation.entity.ntk_dire_bat.flying",
        "head_remodel": "animation.entity.ntk_dire_bat.head_remodel",
        "interested": "animation.entity.ntk_dire_bat.interested",
        "look_at_target": "animation.entity.ntk_dire_bat.look_at_target",
        "resting": "animation.entity.ntk_dire_bat.resting",
        "sitting": "animation.entity.ntk_dire_bat.sitting"
      },
      "scripts": {
        "animate": [
          "controller_attack",
          "controller_interested",
          "controller_movement",
          "head_remodel",
          {
            "baby_remodel": "query.is_baby"
          },
          {
            "look_at_target": "!query.is_resting"
          }
        ]
      }
    }
  }
}
