      },
      "animations": {
        "controller_attack": "controller.animation.entity.ntk_opossum.attack",
        "controller_interested": "controller.animation.entity.ntk_opossum.interested",
        "controller_movement": "controller.animation.entity.ntk_opossum.movement",
        "baby_remodel": "animation.entity.ntk_opossum.baby_remodel",
        "bite_attack": "animation.entity.ntk_opossum.bite_attack",
        "interested": "animation.entity.ntk_opossum.interested",
        "look_at_target": "animation.entity.ntk_opossum.look_at_target",
        "playing_dead": "animation.entity.ntk_opossum.playing_dead",
        "sitting": "animation.entity.ntk_opossum.sitting",
        "walking": "animation.entity.ntk_opossum.walking"
      },
      "scripts": {
				"animate": [
          "controller_attack",
          "controller_interested",
          "controller_movement",
          {
            "baby_remodel": "query.is_baby"
          },
					{
						"look_at_target": "!query.is_playing_dead"
