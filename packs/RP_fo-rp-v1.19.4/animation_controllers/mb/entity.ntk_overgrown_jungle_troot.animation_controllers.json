{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.entity.ntk_overgrown_jungle_troot.attack": {
			"initial_state": "default",
			"states": {
				"default": {
					"blend_transition": 0.0,
					"transitions": [
						{
							"hand_attack": "variable.attack_time > 0.0"
						}
					]
				},
				"hand_attack": {
					"animations": [ "hand_attack" ],
					"blend_transition": 0.0,
					"transitions": [
						{
							"default": "variable.attack_time <= 0.0"
						}
					]
				}
			}
		},
		"controller.animation.entity.ntk_overgrown_jungle_troot.interested": {
			"initial_state": "default",
			"states": {
				"default": {
					"blend_transition": 0.1,
					"transitions": [
						{
							"interested": "query.is_interested && !query.has_target"
						}
					]
				},
				"interested": {
					"animations": [ "interested" ],
					"blend_transition": 0.1,
					"transitions": [
						{
							"default": "!query.is_interested || query.has_target"
						}
					]
				}
			}
		},
		"controller.animation.entity.ntk_overgrown_jungle_troot.movement": {
			"initial_state": "walking",
			"states": {
				"walking": {
					"animations": [
						{
							"walking": "query.modified_move_speed"
						}
					],
					"blend_transition": 0.2,
					"transitions": [
						{
							"sitting": "query.is_sitting"
						}
					]
				},
				"sitting": {
					"animations": [ "sitting" ],
					"blend_transition": 0.2,
					"transitions": [
						{
							"walking": "!query.is_sitting"
						}
					]
				}
			}
		}
	}
}
