{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.entity.ntk_deopard.attack": {
			"initial_state": "default",
			"states": {
				"default": {
					"blend_transition": 0.1,
					"transitions": [
						{
							"bite_attack": "variable.attack_time > 0.0"
						}
					]
				},
				"bite_attack": {
					"animations": [ "bite_attack" ],
					"blend_transition": 0.1,
					"transitions": [
						{
							"default": "variable.attack_time <= 0.0"
						}
					]
				}
			}
		},
		"controller.animation.entity.ntk_deopard.general": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": [ "base_pose" ]
				}
			}
		},
		"controller.animation.entity.ntk_deopard.interested": {
			"initial_state": "default",
			"states": {
				"default": {
					"blend_transition": 0.2,
					"transitions": [
						{
							"interested_tamed": "query.is_interested && query.is_tamed"
						},
						{
							"interested_wild": "query.is_interested && !query.is_tamed"
						}
					]
				},
				"interested_tamed": {
					"animations": [ "interested_tamed" ],
					"blend_transition": 0.2,
					"transitions": [
						{
							"default": "!query.is_interested"
						}
					]
				},
				"interested_wild": {
					"animations": [ "interested_wild" ],
					"blend_transition": 0.2,
					"transitions": [
						{
							"default": "!query.is_interested"
						}
					]
				}
			}
		},
		"controller.animation.entity.ntk_deopard.movement": {
			"initial_state": "walking",
			"states": {
				"walking": {
					"animations": [
						{
							"walking": "query.modified_move_speed"
						}
					],
					"blend_transition": 0.2,
					"transitions": [
						{
							"sitting": "query.is_sitting"
						}
					]
				},
				"sitting": {
					"animations": [ "sitting" ],
					"blend_transition": 0.2,
					"transitions": [
						{
							"walking": "!query.is_sitting"
						}
					]
				}
			}
		}
	}
}