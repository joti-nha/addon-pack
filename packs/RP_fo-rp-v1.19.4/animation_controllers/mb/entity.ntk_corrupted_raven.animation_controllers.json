{"format_version":"1.10.0","animation_controllers":{"controller.animation.entity.ntk_corrupted_raven.attack":{"initial_state":"default","states":{"default":{"blend_transition":0.1,"transitions":[{"beak_attack":"variable.attack_time > 0.0"}]},"beak_attack":{"animations":["beak_attack"],"blend_transition":0.1,"transitions":[{"default":"variable.attack_time <= 0.0"}]}}},"controller.animation.entity.ntk_corrupted_raven.interested":{"initial_state":"default","states":{"default":{"blend_transition":0.2,"transitions":[{"interested":"query.is_interested"}]},"interested":{"animations":["interested"],"blend_transition":0.2,"transitions":[{"default":"!query.is_interested"}]}}},"controller.animation.entity.ntk_corrupted_raven.movement":{"initial_state":"walking","states":{"walking":{"animations":[{"walking":"query.modified_move_speed"}],"blend_transition":0.2,"transitions":[{"flying":"!query.is_on_ground"},{"sitting":"query.is_sitting && query.is_on_ground && !query.is_in_water"}]},"flying":{"animations":["flying"],"blend_transition":0.2,"transitions":[{"walking":"query.is_on_ground"}]},"sitting":{"animations":["sitting"],"blend_transition":0.2,"transitions":[{"walking":"!query.is_sitting || !query.is_on_ground || query.is_in_water"}]}}}}}