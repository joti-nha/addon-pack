{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.item.ntk_wand.wield": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"1st_person_wield": "c.is_first_person && !query.item_is_charged && query.main_hand_item_use_duration <= 0.0"
						},
						{
							"1st_person_wield_charging": "c.is_first_person && !query.item_is_charged && query.main_hand_item_use_duration > 0.0"
						},
						{
							"1st_person_wield_charged": "c.is_first_person && query.item_is_charged && query.main_hand_item_use_duration <= 0.0"
						},
						{
							"3rd_person_wield": "!c.is_first_person && !query.item_is_charged && query.main_hand_item_use_duration <= 0.0"
						},
						{
							"3rd_person_wield_charging": "!c.is_first_person && !query.item_is_charged && query.main_hand_item_use_duration > 0.0"
						},
						{
							"3rd_person_wield_charged": "!c.is_first_person && query.item_is_charged && query.main_hand_item_use_duration <= 0.0"
						}
					]
				},
				"1st_person_wield": {
					"animations": [ "1st_person_wield" ],
					"blend_transition": 0.2,
					"transitions": [
						{
							"default": "!c.is_first_person || query.item_is_charged || query.main_hand_item_use_duration > 0.0"
						}
					]
				},
				"1st_person_wield_charging": {
					"animations": [ "1st_person_wield_charging" ],
					"blend_transition": 0.2,
					"transitions": [
						{
							"default": "!c.is_first_person || query.item_is_charged || query.main_hand_item_use_duration <= 0.0"
						}
					]
				},
				"1st_person_wield_charged": {
					"animations": [ "1st_person_wield_charged" ],
					"blend_transition": 0.2,
					"transitions": [
						{
							"default": "!c.is_first_person || !query.item_is_charged || query.main_hand_item_use_duration > 0.0"
						}
					]
				},
				"3rd_person_wield": {
					"animations": [ "3rd_person_wield" ],
					"blend_transition": 0.2,
					"transitions": [
						{
							"default": "c.is_first_person || query.item_is_charged || query.main_hand_item_use_duration > 0.0"
						}
					]
				},
				"3rd_person_wield_charging": {
					"animations": [ "3rd_person_wield_charging" ],
					"blend_transition": 0.2,
					"transitions": [
						{
							"default": "c.is_first_person || query.item_is_charged || query.main_hand_item_use_duration <= 0.0"
						}
					]
				},
				"3rd_person_wield_charged": {
					"animations": [ "3rd_person_wield_charged" ],
					"blend_transition": 0.2,
					"transitions": [
						{
							"default": "c.is_first_person || !query.item_is_charged || query.main_hand_item_use_duration > 0.0"
						}
					]
				}
			}
		}
	}
}
