{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.entity.ntk_virtuous_flying_book.movement": {
			"initial_state": "flying",
			"states": {
				"flying": {
					"animations": [ "flying" ],
          "blend_transition": 0.0,
					"transitions": [
						{
							"resting": "query.is_resting"
						}
					]
				},
				"resting": {
					"animations": [ "resting" ],
          "blend_transition": 0.0,
					"transitions": [
						{
							"flying": "!query.is_resting"
						}
					]
				}
			}
		},
		"controller.animation.entity.ntk_virtuous_flying_book.particles": {
      "initial_state": "default",
      "states": {
        "default": {
          "particle_effects": [
            {
              "effect": "virtuous_flying_book_particle",
							"locator": "particle"
            }
          ]
        }
      }
    },
    "controller.animation.entity.ntk_virtuous_flying_book.summoning_particles": {
			"initial_state": "default",
			"states": {
				"default": {
          "blend_transition": 0.0,
					"transitions": [
						{
							"summoning_effect": "query.life_span != 0.0"
						}
					]
				},
				"summoning_effect": {
          "blend_transition": 0.0,
					"particle_effects": [
            {
              "effect": "summoning_particle",
							"locator": "particle"
            },
            {
              "effect": "summoned_particle",
							"locator": "particle"
            }
          ],
          "transitions": [
					  {
							"desummoning_effect": "query.life_span == 20.0 || !query.is_alive"
						}
					]
				},
				"desummoning_effect": {
          "blend_transition": 0.0,
					"particle_effects": [
            {
              "effect": "desummoning_particle",
							"locator": "particle"
            }
          ]
				}
			}
		}
	}
}
