{
	"format_version": "1.10.0",
	"animation_controllers": {
	  "controller.animation.entity.ntk_book_keeper.combat": {
			"initial_state": "default",
			"states": {
				"default": {
					"blend_transition": 0.1,
					"transitions": [
						{
							"attack_range": "query.facing_target_to_range_attack && !query.is_casting"
						},
						{
              "casting": "query.is_casting"
            }
					]
				},
				"attack_range": {
					"animations": [ "attack_range" ],
					"particle_effects": [
						{
							"effect": "attack_range_particle",
							"locator": "left_hand_particle"
						},
						{
							"effect": "attack_range_particle",
							"locator": "right_hand_particle"
						}
					],
					"blend_transition": 0.1,
					"transitions": [
						{
							"default": "!query.facing_target_to_range_attack || query.is_casting"
						}
					]
				},
				"casting": {
					"animations": [ "casting" ],
					"particle_effects": [
						{
							"effect": "casting_particle",
							"locator": "left_hand_particle"
						},
						{
							"effect": "casting_particle",
							"locator": "right_hand_particle"
						}
					],
					"transitions": [
						{
							"default": "!query.is_casting"
						}
					]
				}
			}
		},
		"controller.animation.entity.ntk_book_keeper.movement": {
			"initial_state": "walking",
			"states": {
				"walking": {
					"animations": [
						{
							"walking_base": "query.modified_move_speed * 1.5 && !query.facing_target_to_range_attack && !query.is_casting"
						},
						{
							"walking_targeting": "query.modified_move_speed * 1.5 && (query.facing_target_to_range_attack || query.is_casting)"
						}
					],
					"transitions": [
						{
							"get_in_bed": "query.is_sleeping"
						}
					]
				},
				"get_in_bed": {
					"animations": [ "get_in_bed" ],
					"transitions": [
						{
							"walking": "!query.is_sleeping"
						}
					]
				}
			}
		},
		"controller.animation.entity.ntk_book_keeper.trading": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"raising_arm": "query.is_interested && !query.facing_target_to_range_attack && !query.is_casting || query.is_shaking && !query.facing_target_to_range_attack && !query.is_casting"
						}
					]
				},
				"raising_arm": {
					"animations": [ "raise_arm" ],
					"transitions": [
						{
							"default": "!query.is_interested && !query.is_shaking || query.facing_target_to_range_attack || query.is_casting"
						}
					]
				}
			}
		}
  }
}
