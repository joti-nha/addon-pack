{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.entity.ntk_crystalmite.attack": {
			"initial_state": "default",
			"states": {
				"default": {
					"blend_transition": 0.1,
					"transitions": [
						{
							"body_slam_attack": "variable.attack_time > 0.0"
						}
					]
				},
				"body_slam_attack": {
					"animations": [ "body_slam_attack" ],
					"blend_transition": 0.1,
					"transitions": [
						{
							"default": "variable.attack_time <= 0.0"
						}
					]
				}
			}
		},
		"controller.animation.entity.ntk_crystalmite.movement": {
			"initial_state": "walking",
			"states": {
				"walking": {
					"animations": [
						{
							"walking": "query.modified_move_speed * 1.7"
						}
					],
					"blend_transition": 0.5,
					"transitions": [
						{
							"submerged": "query.is_sitting || !query.has_target && !query.is_moving && query.is_on_ground && !query.is_in_water"
						}
					]
				},
				"submerged": {
					"animations": [ "submerged" ],
					"blend_transition": 0.5,
					"transitions": [
						{
							"walking": "query.has_target || query.is_moving || !query.is_on_ground || query.is_in_water"
						}
					]
				}
			}
		}
	}
}
