{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.entity.ntk_piglin.attack": {
			"initial_state": "default",
			"states": {
			  "default": {
					"transitions": [
						{
							"hand_attack": "variable.has_target && !query.is_item_equipped && variable.attack_time >= 0.0 && !query.is_admiring"
						},
						{
							"melee_attack": "variable.has_target && query.is_item_equipped && variable.attack_time >= 0.0 && !query.is_admiring"
						},
						{
							"ranged_charge": "query.get_equipped_item_name('main_hand') == 'crossbow' && query.is_charging && query.facing_target_to_range_attack && !query.is_admiring"
						},
						{
							"ranged_hold": "query.get_equipped_item_name('main_hand') == 'crossbow' && query.is_charged && query.facing_target_to_range_attack && !query.is_admiring"
						},
						{
							"blazing_staff_attack": "query.get_equipped_item_name('main_hand') == 'blazing_staff' && query.has_target && query.facing_target_to_range_attack && !query.is_admiring"
						},
						{
							"curserer_staff_attack": "query.get_equipped_item_name('main_hand') == 'curserer_staff' && query.has_target && query.facing_target_to_range_attack && !query.is_admiring"
						},
						{
							"piglin_fire_staff_attack": "query.get_equipped_item_name('main_hand') == 'piglin_fire_staff' && query.has_target && query.facing_target_to_range_attack && !query.is_admiring"
						},
						{
							"powder_staff_attack": "query.get_equipped_item_name('main_hand') == 'powder_staff' && query.has_target && query.facing_target_to_range_attack && !query.is_admiring"
						}
					]
				},
			  "hand_attack": {
					"animations": [ "hand_attack" ],
					"transitions": [
						{
							"default": "query.is_item_equipped || !variable.has_target || variable.attack_time < 0.0 || query.is_admiring"
						}
					]
				},
				"melee_attack": {
					"animations": [ "melee_attack" ],
					"transitions": [
						{
							"default": "!query.is_item_equipped || !variable.has_target || variable.attack_time < 0.0 || query.is_admiring"
						}
					]
				},
				"ranged_charge": {
					"animations": [ "crossbow_charge" ],
					"transitions": [
						{
							"default": "query.get_equipped_item_name('main_hand') != 'crossbow' || !query.is_charging || !query.facing_target_to_range_attack || query.is_admiring"
						},
						{
							"ranged_hold": "query.is_charged"
						}
					]
				},
				"ranged_hold": {
					"animations": [ "crossbow_hold" ],
					"transitions": [
						{
							"default": "query.get_equipped_item_name('main_hand') != 'crossbow' || !query.is_charged || !query.facing_target_to_range_attack || query.is_admiring"
						},
						{
							"ranged_charge": "query.is_charging"
						}
					]
				},
				"blazing_staff_attack": {
					"animations": [ "magic_staff_attack" ],
					"transitions": [
						{
							"default": "query.get_equipped_item_name('main_hand') != 'blazing_staff' || !query.has_target || !query.facing_target_to_range_attack || query.is_admiring"
						}
					]
				},
				"curserer_staff_attack": {
					"animations": [ "magic_staff_attack" ],
					"transitions": [
						{
							"default": "query.get_equipped_item_name('main_hand') != 'curserer_staff' || !query.has_target || !query.facing_target_to_range_attack || query.is_admiring"
						}
					]
				},
				"piglin_fire_staff_attack": {
					"animations": [ "magic_staff_attack" ],
					"transitions": [
						{
							"default": "query.get_equipped_item_name('main_hand') != 'piglin_fire_staff' || !query.has_target || !query.facing_target_to_range_attack || query.is_admiring"
						}
					]
				},
				"powder_staff_attack": {
					"animations": [ "magic_staff_attack" ],
					"transitions": [
						{
							"default": "query.get_equipped_item_name('main_hand') != 'powder_staff' || !query.has_target || !query.facing_target_to_range_attack || query.is_admiring"
						}
					]
				}
			}
		},
		"controller.animation.entity.ntk_piglin.look_at_target": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": [ "look_at_target_default" ],
          "transitions": [
            {
              "gliding": "query.is_gliding"
            },
            {
              "swimming": "query.is_swimming || query.is_crawling"
            }
          ]
        },
        "gliding": {
          "animations": [ "look_at_target_gliding" ],
          "transitions": [
            {
              "default": "!query.is_gliding"
            },
            {
              "swimming": "query.is_swimming || query.is_crawling"
            }
          ]
        },
        "swimming": {
          "animations": [ "look_at_target_swimming" ],
          "transitions": [
            {
              "default": "!query.is_swimming && !query.is_crawling"
            },
            {
              "gliding": "query.is_gliding"
            }
          ]
        }
      }
    },
    "controller.animation.entity.ntk_piglin.melee_spear": {
      "initial_state": "hold",
      "states": {
        "hold": {
          "animations": [ "melee_spear_hold" ],
          "transitions": [
            {
              "use": "variable.item_use_normalized > 0.0"
            }
          ]
        },
        "use": {
          "animations": [ "melee_spear_use" ],
          "transitions": [
            {
              "hold": "variable.item_use_normalized == 0.0"
            }
          ],
          "blend_transition": 1.0
        }
      }
    },
    "controller.animation.entity.ntk_piglin.riding": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "riding": "query.is_riding"
            }
          ]
        },
        "riding": {
          "animations": [
            "riding.arms",
            "riding.body",
            "riding.legs"
          ],
          "transitions": [
            {
              "default": "!query.is_riding"
            }
          ]
        }
      }
    }
	}
}
