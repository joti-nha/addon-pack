{
	"format_version": "1.10.0",
	"animation_controllers": {
	  "controller.animation.entity.ntk_crates_trader.base_pose": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"base_pose_dwelling": "query.variant == 0"
						},
						{
							"base_pose_wandering": "query.variant != 0"
						}
					]
				},
				"base_pose_dwelling": {
					"animations": [ "base_pose_dwelling" ],
					"transitions": [
						{
							"base_pose_wandering": "query.variant != 0"
						}
					]
				},
				"base_pose_wandering": {
					"animations": [ "base_pose_wandering" ],
					"transitions": [
						{
							"base_pose_dwelling": "query.variant == 0"
						}
					]
				}
			}
		},
		"controller.animation.entity.ntk_crates_trader.movement": {
			"initial_state": "walking",
			"states": {
				"walking": {
					"animations": [
						{
							"walking_dwelling": "query.variant == 0 && query.modified_move_speed * 1.5"
						},
						{
							"walking_dwelling": "query.variant != 0 && query.modified_move_speed * 1.5 && query.is_shaking"
						},
						{
							"walking_wandering": "query.variant != 0 && query.modified_move_speed * 1.5 && !query.is_shaking"
						}
					],
					"transitions": [
						{
							"get_in_bed": "query.is_sleeping"
						}
					]
				},
				"get_in_bed": {
					"animations": [ "get_in_bed" ],
					"transitions": [
						{
							"walking": "!query.is_sleeping"
						}
					]
				}
			}
		},
		"controller.animation.entity.ntk_crates_trader.trading": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{
							"raising_arm_dwelling": "query.variant == 0 && query.is_interested || query.variant == 0 && query.is_shaking"
						},
						{
							"raising_arm_wandering": "query.variant != 0 && query.is_interested || query.variant != 0 && query.is_shaking"
						}
					]
				},
				"raising_arm_dwelling": {
					"animations": [ "raise_arm_dwelling" ],
					"transitions": [
						{
							"default": "!query.is_interested && !query.is_shaking"
						}
					]
				},
				"raising_arm_wandering": {
					"animations": [ "raise_arm_wandering" ],
					"transitions": [
						{
							"default": "!query.is_interested && !query.is_shaking"
						}
					]
				}
			}
		}
  }
}
