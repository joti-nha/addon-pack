{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.entity.ntk_sand_cube.attack": {
			"initial_state": "default",
			"states": {
				"default": {
					"blend_transition": 0.0,
					"transitions": [
						{
							"body_slam_attack": "variable.attack_time > 0.0"
						}
					]
				},
				"body_slam_attack": {
					"animations": [ "body_slam_attack" ],
					"blend_transition": 0.0,
					"transitions": [
						{
							"default": "variable.attack_time <= 0.0"
						}
					]
				}
			}
		},
		"controller.animation.entity.ntk_sand_cube.general": {
      "initial_state": "default",
      "states": {
        "default": {
          "particle_effects": [
            {
              "effect": "sand_cube_particle",
							"locator": "particle"
            }
          ]
        }
      }
    },
		"controller.animation.entity.ntk_sand_cube.movement": {
			"initial_state": "crawling",
			"states": {
				"crawling": {
					"animations": [
						{
							"crawling": "query.modified_move_speed"
						}
					]
				}
			}
		}
	}
}