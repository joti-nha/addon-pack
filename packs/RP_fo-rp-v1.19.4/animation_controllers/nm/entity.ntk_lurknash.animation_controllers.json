{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.entity.ntk_lurknash.attack": {
			"initial_state": "default",
			"states": {
				"default": {
					"blend_transition": 0.0,
					"transitions": [
						{
							"bite_attack": "variable.attack_time > 0.0"
						}
					]
				},
				"bite_attack": {
					"animations": [ "bite_attack" ],
					"blend_transition": 0.0,
					"transitions": [
						{
							"default": "variable.attack_time <= 0.0"
						}
					]
				}
			}
		},
		"controller.animation.entity.ntk_lurknash.interested": {
			"initial_state": "default",
			"states": {
				"default": {
					"blend_transition": 0.2,
					"transitions": [
						{
							"interested": "query.is_interested"
						}
					]
				},
				"interested": {
					"animations": [ "interested" ],
					"blend_transition": 0.2,
					"transitions": [
						{
							"default": "!query.is_interested"
						}
					]
				}
			}
		},
		"controller.animation.entity.ntk_lurknash.movement": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": [
						{
							"walking": "query.modified_move_speed"
						}
					],
					"blend_transition": 0.2,
					"transitions": [
						{
							"sitting": "query.is_sitting"
						},
						{
							"sprinting": "query.is_sprinting"
						}
					]
				},
				"sitting": {
					"animations": [ "sitting" ],
					"blend_transition": 0.2,
					"transitions": [
						{
							"default": "!query.is_sitting"
						}
					]
				},
				"sprinting": {
					"animations": [ "sprinting" ],
					"blend_transition": 0.2,
					"transitions": [
						{
							"default": "!query.is_sprinting"
						}
					]
				}
			}
		}
	}
}