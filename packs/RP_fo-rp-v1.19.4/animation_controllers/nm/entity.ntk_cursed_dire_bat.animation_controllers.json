{"format_version":"1.10.0","animation_controllers":{"controller.animation.entity.ntk_cursed_dire_bat.attack":{"initial_state":"default","states":{"default":{"blend_transition":0.0,"transitions":[{"bite_attack":"variable.attack_time > 0.0"}]},"bite_attack":{"animations":["bite_attack"],"blend_transition":0.0,"transitions":[{"default":"variable.attack_time <= 0.0"}]}}},"controller.animation.entity.ntk_cursed_dire_bat.interested":{"initial_state":"default","states":{"default":{"blend_transition":0.2,"transitions":[{"interested":"query.is_interested"}]},"interested":{"animations":["interested"],"blend_transition":0.2,"transitions":[{"default":"!query.is_interested"}]}}},"controller.animation.entity.ntk_cursed_dire_bat.movement":{"initial_state":"flying","states":{"flying":{"animations":["flying"],"blend_transition":0.2,"transitions":[{"resting":"query.is_resting"},{"sitting":"query.is_sitting && query.is_on_ground && !query.is_in_water"}]},"resting":{"animations":["resting"],"blend_transition":0.2,"transitions":[{"flying":"!query.is_resting"}]},"sitting":{"animations":["sitting"],"blend_transition":0.2,"transitions":[{"flying":"!query.is_sitting || !query.is_on_ground || query.is_in_water"}]}}},"controller.animation.entity.ntk_cursed_dire_bat.particles":{"initial_state":"default","states":{"default":{"particle_effects":[{"effect":"cursed_dire_bat_particle","locator":"particle"}]}}}}}