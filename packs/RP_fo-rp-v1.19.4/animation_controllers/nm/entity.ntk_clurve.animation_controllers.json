{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.entity.ntk_clurve.attack": {
			"initial_state": "default",
			"states": {
				"default": {
					"blend_transition": 0.0,
					"transitions": [
						{
							"bite_attack": "variable.attack_time > 0.0"
						}
					]
				},
				"bite_attack": {
					"animations": [ "bite_attack" ],
					"blend_transition": 0.0,
					"transitions": [
						{
							"default": "variable.attack_time <= 0.0"
						}
					]
				}
			}
		},
		"controller.animation.entity.ntk_clurve.movement": {
			"initial_state": "walking",
			"states": {
				"walking": {
					"animations": [
						{
							"walking": "query.modified_move_speed * 1.2"
						}
					],
					"blend_transition": 0.2,
					"transitions": [
						{
							"swimming": "!query.is_on_ground && query.is_in_water"
						}
					]
				},
				"swimming": {
					"animations": [
						{
							"swimming": "query.modified_move_speed"
						}
					],
					"blend_transition": 0.1,
					"transitions": [
						{
							"walking": "query.is_on_ground && !query.is_in_water"
						}
					]
				}
			}
		}
	}
}
