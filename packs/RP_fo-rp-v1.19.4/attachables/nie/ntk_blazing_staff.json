{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "ntk:blazing_staff",
      "item": {
				"ntk:blazing_staff": "query.get_equipped_item_name('main_hand') == 'blazing_staff'"
			},
			"render_controllers": [
        "controller.render.item.ntk_blazing_staff"
      ],
      "geometry": {
        "default": "geometry.item.ntk_blazing_staff"
      },
      "materials": {
        "default": "ntk_item_emissive_nocull_alpha",
        "enchanted": "ntk_item_emissive_nocull_alpha"
      },
      "textures": {
        "default": "textures/models/nie/ntk_blazing_staff",
        "enchanted": "textures/models/nie/ntk_blazing_staff"
      },
      "animations": {
        "controller_wield": "controller.animation.item.ntk_blazing_staff.wield",
        "1st_person_wield": "animation.item.ntk_blazing_staff.1st_person_wield",
        "3rd_person_wield": "animation.item.ntk_blazing_staff.3rd_person_wield",
        "staff_animation": "animation.item.ntk_blazing_staff.staff_animation"
      },
      "scripts": {
        "should_update_bones_and_effects_offscreen": true,
        "animate": [
          "controller_wield",
          "staff_animation"
        ]
      }
    }
  }
}