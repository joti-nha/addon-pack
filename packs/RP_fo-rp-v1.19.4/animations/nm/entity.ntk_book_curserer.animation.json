{
	"format_version": "1.8.0",
	"animations": {
		"animation.entity.ntk_book_curserer.base_pose": {
			"override_previous_animation": false,
			"loop": true,
			"bones": {
				"arms": {
					"position": [ 0.0, "-3.0 - this", "-1.0 - this" ],
					"rotation": [ "-42.97 - this", "- this", "- this" ],
					"scale": 1.0
				},
				"leftArm": {
					"scale": 0.0
				},
				"rightArm": {
					"scale": 0.0
				}
			}
		},
		"animation.entity.ntk_book_curserer.casting": {
			"override_previous_animation": false,
			"loop": true,
			"bones": {
				"arms": {
					"scale": 0.0
				},
				"leftArm": {
					"rotation": [ "math.cos(query.life_time * 763.4) * 14.3239 - this", "-this", "-135.0 - this" ],
					"scale": 1.0
				},
				"rightArm": {
					"rotation": [ "math.cos(query.life_time * 763.4) * 14.3239 - this", "-this", "135.0 - this" ],
					"scale": 1.0
				}
			}
		},
		"animation.entity.ntk_book_curserer.celebrating": {
			"override_previous_animation": false,
			"loop": true,
			"bones": {
				"leftArm": {
					"rotation": [ "(math.cos(query.life_time * 800.0) * 2.865)", 180.0, -135.0 ]
				},
				"rightArm": {
					"rotation": [ "(math.cos(query.life_time * 800.0) * 2.865)", 180.0, 153.0 ]
				}
			}
		},
		"animation.entity.ntk_book_curserer.riding": {
			"override_previous_animation": false,
			"loop": true,
			"bones": {
				"root": {
					"position": [0, -8, 0]
				},
				"leftLeg": {
					"rotation": [ "-72.0 - this", "-18.0 - this", "-this" ]
				},
				"rightLeg": {
					"rotation": [ "-72.0 - this", "18.0 - this", "-this" ]
				}
			}
		},
		"animation.entity.ntk_book_curserer.look_at_target": {
			"override_previous_animation": false,
			"loop": true,
			"bones": {
				"head": {
					"relative_to": {
						"rotation": "entity"
					},
					"rotation": [ "query.target_x_rotation - this", "query.target_y_rotation - this", 0.0 ]
				}
			}
		},
		"animation.entity.ntk_book_curserer.walking": {
			"override_previous_animation": false,
			"anim_time_update": "query.modified_distance_moved",
			"loop": true,
			"bones": {
				"rightLeg": {
					"rotation": [ "(math.cos(query.anim_time * 38.17) * 40.0) - this", "-this", 0.0 ]
				},
				"leftLeg": {
					"rotation": [ "(math.cos(query.anim_time * 38.17 + 180) * 40.0) - this", "-this", 0.0 ]
				}
			}
		}
	}
}
