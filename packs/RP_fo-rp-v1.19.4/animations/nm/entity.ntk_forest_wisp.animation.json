{
	"format_version": "1.8.0",
	"animations": {
		"animation.entity.ntk_forest_wisp.floating": {
			"override_previous_animation": false,
      "loop": true,
			"animation_length": 1,
			"bones": {
				"body": {
					"position": {
						"0.0": [0, 0, 0],
						"0.5": [0, 1, 0],
						"1.0": [0, 0, 0]
					}
				},
				"armor": {
					"position": {
						"0.0": [0, 0, 0],
						"0.5": [0, -1, 0],
						"1.0": [0, 0, 0]
					},
					"scale": {
						"0.0": [0.8, 0.8, 0.8],
						"0.5": [1, 0.8, 1],
						"1.0": [0.8, 0.8, 0.8]
					}
				}
			}
    },
    "animation.entity.ntk_forest_wisp.look_at_target": {
			"override_previous_animation": false,
			"loop": true,
			"bones": {
				"body": {
					"relative_to": {
						"rotation": "entity"
					},
					"rotation": [
						"query.target_x_rotation - this",
						"query.target_y_rotation - this",
						0.0
					]
				}
			}
		}
	}
}
