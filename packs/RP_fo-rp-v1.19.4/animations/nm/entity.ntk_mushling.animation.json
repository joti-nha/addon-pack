{
	"format_version": "1.8.0",
	"animations": {
		"animation.entity.ntk_mushling.look_at_target": {
			"loop": true,
			"bones": {
				"head": {
					"relative_to": {
						"rotation": "entity"
					},
					"rotation": [
						"query.target_x_rotation - this",
						"query.target_y_rotation - this",
						0.0
					]
				}
			}
		},
		"animation.entity.ntk_mushling.sitting": {
			"loop": true,
			"bones": {
				"head": {
					"position": [0, -2, 0]
				},
				"leg_left": {
					"position": [0, 1, 0],
					"scale": [1, 0, 1]
				},
				"leg_right": {
					"position": [0, 1, 0],
					"scale": [1, 0, 1]
				}
			}
		},
		"animation.entity.ntk_mushling.sleeping": {
			"loop": true,
			"bones": {
				"head": {
					"position": [0, -2, 0]
				},
				"leg_left": {
					"position": [0, -1, 0]
				},
				"leg_right": {
					"position": [0, -1, 0]
				}
			}
		},
		"animation.entity.ntk_mushling.walking": {
			"loop": true,
			"anim_time_update": "query.modified_distance_moved",
			"bones": {
				"leg_right": {
					"rotation": [ "math.cos(query.anim_time * 45.0) * 45.0", 0.0, 0.0 ]
				},
				"leg_left": {
					"rotation": [ "math.cos(query.anim_time * 45.0) * -45.0", 0.0, 0.0 ]
				}
			}
		}
	}
}