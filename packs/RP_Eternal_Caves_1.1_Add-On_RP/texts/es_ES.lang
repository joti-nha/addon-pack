settings.panascais_caves:color_tint.title=Biome Color Tinting
settings.panascais_caves:color_tint.explanation=§7Whether to apply a subtle color tint to the world when in a cave biome. This enhances immersion by giving each biome a unique atmosphere.\n§8(§oNote: Has no effect when playing with Vibrant Visuals)
settings.panascais_caves:distance_fog.title=Biome Distance Fog
settings.panascais_caves:distance_fog.explanation=§7Whether to apply distance fog in cave biomes. This enhances the overall atmosphere but may reduce visibility slightly.
settings.panascais_caves:particles.title=Ambience Particles
settings.panascais_caves:particles.distance=Particle Distance
settings.panascais_caves:particles.distance_explanation=§7Controls the distance at which cave particles are spawned.
settings.panascais_caves:particles.distance_tooltip=§o§cHigher values may impact performance.
settings.panascais_caves:particles.toggle_caves=Toggle Particles for Caves:
