settings.panascais_caves:ambient_sounds.sound_volume=Sound Volume
settings.panascais_caves:ambient_sounds.sound_volume_explanation=§7Controls the volume of ambient background cave sounds.
settings.panascais_caves:ambient_sounds.sound_volume_tooltip=§oVolume changes take effect after a few seconds.
settings.panascais_caves:ambient_sounds.toggle_caves=Toggle Sounds for Caves:
