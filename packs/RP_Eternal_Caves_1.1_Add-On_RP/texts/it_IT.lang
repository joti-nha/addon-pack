settings.panascais_caves:caves.group.special=Caverne speciali
settings.panascais_caves:color_tint.title=Tinta colore bioma
settings.panascais_caves:color_tint.explanation=§7Determina se applicare una lieve tinta cromatica al mondo quando ti trovi in un bioma di caverna. Aumenta l'immersione dando a ogni bioma un'atmosfera unica.\n§8(§oNota: non ha effetto con Grafica vivida)
settings.panascais_caves:distance_fog.title=Nebbia distanza bioma
settings.panascais_caves:distance_fog.explanation=§7Determina se applicare la nebbia di distanza nei biomi di caverna. Migliora l'atmosfera generale ma può ridurre leggermente la visibilità.
settings.panascais_caves:particles.title=Particelle ambientali
settings.panascais_caves:particles.distance=Distanza particelle
settings.panascais_caves:particles.distance_explanation=§7Controlla la distanza a cui vengono generate le particelle delle caverne.
settings.panascais_caves:particles.distance_tooltip=§o§cValori più alti possono influire sulle prestazioni.
settings.panascais_caves:particles.toggle_caves=Attiva/disattiva particelle per le caverne:
settings.panascais_caves:ambient_sounds.title=Suoni ambientali delle caverne
settings.panascais_caves:ambient_sounds.sound_volume=Volume suoni
settings.panascais_caves:ambient_sounds.sound_volume_explanation=§7Controlla il volume dei suoni ambientali di sottofondo delle caverne.
settings.panascais_caves:ambient_sounds.sound_volume_tooltip=§oLe modifiche al volume hanno effetto dopo pochi secondi.
settings.panascais_caves:ambient_sounds.toggle_caves=Attiva/disattiva suoni per le caverne:
settings.panascais_caves:random_sounds.title=Suoni casuali delle caverne
settings.panascais_caves:random_sounds.sound_volume=Volume suoni
settings.panascais_caves:random_sounds.sound_volume_explanation=§7Controlla il volume dei suoni casuali delle caverne.
settings.panascais_caves:random_sounds.sound_volume_tooltip=§oLe modifiche al volume hanno effetto dopo pochi secondi.
settings.panascais_caves:random_sounds.toggle_caves=Attiva/disattiva suoni per le caverne:
settings.panascais_caves:dynamic_light.title=Luce dinamica
settings.panascais_caves:dynamic_light.explanation=§7Il sistema di luce dinamica permette a determinati oggetti, armature e blocchi di emettere luce quando vengono tenuti in mano o indossati. Usa questi interruttori per scegliere quali fonti possono emettere luce.
settings.panascais_caves:dynamic_light.vanilla=Vanilla
settings.panascais_caves:dynamic_light.vanilla_tooltip=Attiva/disattiva la luce dinamica per oggetti, armature e blocchi di Minecraft vanilla.
settings.panascais_caves:dynamic_light.caves=Eternal Caves
settings.panascais_caves:dynamic_light.caves_tooltip=Attiva/disattiva la luce dinamica per oggetti, armature e blocchi di Eternal Caves.
settings.panascais_caves:dynamic_light.other=Altri add-on
settings.panascais_caves:dynamic_light.other_tooltip=Attiva/disattiva la luce dinamica per oggetti, armature e blocchi di altri add-on che supportano il sistema di luce dinamica di Eternal Caves.
