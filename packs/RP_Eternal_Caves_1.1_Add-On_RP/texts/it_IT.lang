settings.panascais_caves:information=§7Grazie per aver giocato a Eternal Caves!\n§7Usa queste impostazioni per adattare l'add-on al tuo stile di gioco.\n\n§b- Wiki: pnsc.is/caves/wiki\n§r§d- Discord: pnsc.is/discord
settings.panascais_caves:caves.title=Impostazioni caverne
settings.panascais_caves:caves.group.current=Caverna attuale
settings.panascais_caves:caves.group.vanilla=Caverne vanilla
