settings.panascais_caves:caves.group.biome=Cavernes de biome
settings.panascais_caves:caves.group.special=Cavernes speciales
settings.panascais_caves:color_tint.title=Teinte de couleur du biome
settings.panascais_caves:color_tint.explanation=§7Applique une legere teinte de couleur au monde dans un biome de caverne. Cela renforce l'immersion en donnant une atmosphere unique a chaque biome.\n§8(§oRemarque : sans effet avec les graphismes Vibrant Visuals)
settings.panascais_caves:distance_fog.title=Brouillard de distance du biome
settings.panascais_caves:distance_fog.explanation=§7Applique un brouillard de distance dans les biomes de caverne. Cela renforce l'atmosphere generale, mais peut reduire legerement la visibilite.
settings.panascais_caves:particles.title=Particules d'ambiance
settings.panascais_caves:particles.distance=Distance des particules
settings.panascais_caves:particles.distance_explanation=§7Controle la distance a laquelle les particules de caverne apparaissent.
settings.panascais_caves:particles.distance_tooltip=§o§cLes valeurs elevees peuvent nuire aux performances.
settings.panascais_caves:particles.toggle_caves=Activer les particules des cavernes :
settings.panascais_caves:ambient_sounds.title=Sons d'ambiance des cavernes
settings.panascais_caves:ambient_sounds.sound_volume=Volume sonore
settings.panascais_caves:ambient_sounds.sound_volume_explanation=§7Controle le volume des sons d'ambiance des cavernes.
settings.panascais_caves:ambient_sounds.sound_volume_tooltip=§oLes changements de volume prennent effet apres quelques secondes.
settings.panascais_caves:ambient_sounds.toggle_caves=Activer les sons des cavernes :
settings.panascais_caves:random_sounds.title=Sons aleatoires des cavernes
