settings.panascais_caves:color_tint.title=Biom-Farbtönung
settings.panascais_caves:color_tint.explanation=§7Legt fest, ob in einem Höhlenbiom eine dezente Farbtönung auf die Welt angewendet wird. Das verstärkt die Atmosphäre und gibt jedem Biom eine eigene Stimmung.\n§8(§oHinweis: Hat keine Wirkung, wenn mit Vibrant Visuals gespielt wird)
settings.panascais_caves:distance_fog.title=Biom-Sichtweitennebel
settings.panascais_caves:distance_fog.explanation=§7Legt fest, ob in Höhlenbiomen Sichtweitennebel angewendet wird. Das verstärkt die Atmosphäre, kann die Sicht aber leicht verringern.
settings.panascais_caves:particles.title=Atmosphärenpartikel
settings.panascais_caves:particles.distance=Partikeldistanz
settings.panascais_caves:particles.distance_explanation=§7Steuert die Distanz, in der Höhlenpartikel erzeugt werden.
settings.panascais_caves:particles.distance_tooltip=§o§cHöhere Werte können die Leistung beeinträchtigen.
