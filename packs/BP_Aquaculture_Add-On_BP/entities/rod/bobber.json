{
  "format_version": "1.21.50",
  "minecraft:entity": {
    "description": {
      "identifier": "tm_aqc:bobber",
      "is_summonable": true,
      "is_spawnable": false,
      "is_experimental": false,
      "properties": {
        "tm_aqc:lure_cooldown": {
          "type": "int",
          "range": [-1, 1000],
          "default": -1,
          "client_sync": false
        },
        "tm_aqc:hook": {
          "type": "int",
          "range": [0, 12],
          "default": 0,
          "client_sync": true
        },
        "tm_aqc:bobber": {
          "type": "int",
          "range": [0, 5],
          "default": 0,
          "client_sync": true
        },
        "tm_aqc:bite": {
          "type": "bool",
          "default": false,
          "client_sync": false
        },
        "tm_aqc:in_water": {
          "type": "bool",
          "default": false,
          "client_sync": false
        },
        "tm_aqc:glow": {
          "type": "bool",
          "default": false,
          "client_sync": true
        },
        "tm_aqc:colour": {
          "type": "int",
          "range": [-1, 15],
          "default": 0,
          "client_sync": true
        }
      }
    },
    "component_groups": {
        "tm_aqc:float":{
          "minecraft:buoyant": {
          "base_buoyancy": 1,
          "apply_gravity": true,
          "big_wave_probability": 0.03,
          "big_wave_speed": 10,
          "drag_down_on_buoyancy_removed": 1,
          "liquid_blocks": [
              "minecraft:water"
          ],
          "simulate_waves": true
        }
      },
      "tm_aqc:bite":{
          "minecraft:buoyant": {
          "base_buoyancy": 0,
          "apply_gravity": true,
          "big_wave_probability": 0.03,
          "big_wave_speed": 10,
          "drag_down_on_buoyancy_removed": 0,
          "liquid_blocks": [
              "minecraft:water"
          ],
          "simulate_waves": true
        },
        "minecraft:timer": {
          "time": [2, 4],
          "looping": true,
          "time_down_event": {
            "event": "tm_aqc:float",
            "target": "self"
          }
        }

      },
      "tm_aqc:bite_redstone_hook":{
          "minecraft:buoyant": {
          "base_buoyancy": 0,
          "apply_gravity": true,
          "big_wave_probability": 0.03,
          "big_wave_speed": 10,
          "drag_down_on_buoyancy_removed": 0,
          "liquid_blocks": [
              "minecraft:water"
          ],
          "simulate_waves": true
        },
        "minecraft:timer": {
          "time": [4, 6],
          "looping": true,
          "time_down_event": {
            "event": "tm_aqc:float",
            "target": "self"
          }
        }

      }
    },
    "components": {
      "minecraft:type_family": {
        "family": ["bobber", "inanimate"]
      },
      "minecraft:damage_sensor": {
        "triggers": {
          "on_damage": {
            "filters": {}
          },
          "deals_damage": "no"
        }
      },
      "minecraft:projectile": {
        "angle_offset": -20.0,
        "power": 1,
        "gravity": 0.00001,
        "knockback": false,
        "should_bounce": false,
        "splash_potion": false,
        "on_hit": {
          "stick_in_ground": {}
        }
        
      },
      "minecraft:leashable": {
        "can_be_stolen": false,
        "hard_distance": 30,
        "max_distance": 40,
        "soft_distance": 25
      },
      "minecraft:health": {
        "value": 1,
        "max": 1
      },
      "minecraft:knockback_resistance": {
        "value": 1,
        "max": 1
      },
      "minecraft:push_through": {
        "value": 1
      },
      "minecraft:environment_sensor": {
        "triggers": [
          {
            "event": "tm_aqc:in_water",
            "target": "self",
            "filters": {
              "all_of": [
                {
                  "test": "is_underwater",
                  "value": true
                },
                {
                  "test": "bool_property",
                  "domain": "tm_aqc:in_water",
                  "value": false
                }
              ]
            }
          }
        ]
      },
      
      "minecraft:collision_box": {
        "width": 0.1,
        "height": 0.25
      },
      "minecraft:physics": {
        "has_gravity": true,
        "has_collision": true
      },
      "minecraft:pushable": {
        "is_pushable": false,
        "is_pushable_by_piston": false
      },
      "minecraft:conditional_bandwidth_optimization": {
        "default_values": {
          "max_optimized_distance": 80.0,
          "max_dropped_ticks": 5,
          "use_motion_prediction_hints": true
        }
      }
    },
    "events": {
      "minecraft:entity_spawned": {
        "add": {
          "component_groups": [
            "tm_aqc:float"
          ]
        }
      },
      "tm_aqc:bite": {
        "remove": {
          "component_groups": [
            "tm_aqc:float"
          ]
        },
        "add": {
          "component_groups": [
            "tm_aqc:bite"
          ]
        },
        "set_property": {
          "tm_aqc:bite": true
        }
      },
      "tm_aqc:bite_redstone_hook": {
        "remove": {
          "component_groups": [
            "tm_aqc:float"
          ]
        },
        "add": {
          "component_groups": [
            "tm_aqc:bite_redstone_hook"
          ]
        },
        "set_property": {
          "tm_aqc:bite": true
        }
      },
      "tm_aqc:float": {
        "add": {
          "component_groups": [
            "tm_aqc:float"
          ]
        },
        "remove": {
          "component_groups": [
            "tm_aqc:bite"
          ]
        },
        "set_property": {
          "tm_aqc:bite": false
        }
      },
      "tm_aqc:in_water": {
        "set_property": {
          "tm_aqc:in_water": true
        }
      },
      "tm_aqc:not_in_water": {
        "set_property": {
          "tm_aqc:in_water": false
        }
      }
    }
  }
}
