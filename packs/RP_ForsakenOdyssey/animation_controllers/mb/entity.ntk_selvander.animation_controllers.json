{"format_version":"1.10.0","animation_controllers":{"controller.animation.entity.ntk_selvander.attack":{"initial_state":"default","states":{"default":{"blend_transition":0.1,"transitions":[{"bite_attack":"variable.attack_time > 0.0"}]},"bite_attack":{"animations":["bite_attack"],"blend_transition":0.1,"transitions":[{"default":"variable.attack_time <= 0.0"}]}}},"controller.animation.entity.ntk_selvander.interested":{"initial_state":"default","states":{"default":{"blend_transition":0.2,"transitions":[{"interested":"query.is_interested && !query.has_target"}]},"interested":{"animations":["interested"],"blend_transition":0.2,"transitions":[{"default":"!query.is_interested || query.has_target"}]}}},"controller.animation.entity.ntk_selvander.general":{"initial_state":"default","states":{"default":{"blend_transition":0.2,"transitions":[{"underwater_pose":"query.is_in_water && !query.is_moving || !query.is_on_ground && !query.is_moving"}]},"underwater_pose":{"animations":["underwater_pose"],"blend_transition":0.2,"transitions":[{"default":"!query.is_in_water || query.is_on_ground && !query.is_in_water || query.is_moving"}]}}},"controller.animation.entity.ntk_selvander.movement":{"initial_state":"walking","states":{"walking":{"animations":[{"walking":"query.modified_move_speed * 1.2"}],"blend_transition":0.2,"transitions":[{"sitting":"query.is_sitting && query.is_on_ground && !query.is_in_water"},{"swimming":"query.is_in_water && !query.is_on_ground"}]},"sitting":{"animations":["sitting"],"blend_transition":0.2,"transitions":[{"walking":"!query.is_sitting || !query.is_on_ground || query.is_in_water"}]},"swimming":{"animations":[{"swimming":"query.modified_move_speed * 1.2"}],"blend_transition":0.2,"transitions":[{"walking":"query.is_on_ground && !query.is_in_water"}]}}}}}