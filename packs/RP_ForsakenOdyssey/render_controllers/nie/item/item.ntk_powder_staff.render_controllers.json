{
  "format_version": "1.10",
  "render_controllers": {
    "controller.render.item.ntk_powder_staff": {
      "arrays": {
        "textures": {
          "array.powder_staff_texture": [
            "texture.powder_staff_uncharged",      // 0
            "texture.powder_staff_charged",        // 1
            "texture.amethyst_powder_staff",       // 2
            "texture.charcoal_powder_staff",          // 3
            "texture.copper_powder_staff",         // 4
            "texture.diamond_powder_staff",        // 5
            "texture.emerald_powder_staff",        // 6
            "texture.enchanted_powder_staff",      // 7
            "texture.gold_powder_staff",           // 8
            "texture.iron_powder_staff",           // 9
            "texture.lapis_lazuli_powder_staff",   // 10
            "texture.netherite_powder_staff"       // 11
          ]
        }
      },
      "geometry": "geometry.default",
      "materials": [
        {
          "*": "variable.is_enchanted ? material.enchanted : material.default"
        }
      ],
      "textures": [
        "array.powder_staff_texture[query.item_is_charged ? (query.is_item_name_any('slot.weapon.offhand', 0, 'ntk:amethyst_powder') ? 2 : query.is_item_name_any('slot.weapon.offhand', 0, 'ntk:charcoal_powder') ? 3 : query.is_item_name_any('slot.weapon.offhand', 0, 'ntk:copper_powder') ? 4 : query.is_item_name_any('slot.weapon.offhand', 0, 'ntk:diamond_powder') ? 5 : query.is_item_name_any('slot.weapon.offhand', 0, 'ntk:emerald_powder') ? 6 : query.is_item_name_any('slot.weapon.offhand', 0, 'ntk:enchanted_dust') ? 7 : query.is_item_name_any('slot.weapon.offhand', 0, 'ntk:gold_powder') ? 8 : query.is_item_name_any('slot.weapon.offhand', 0, 'ntk:iron_powder') ? 9 : query.is_item_name_any('slot.weapon.offhand', 0, 'ntk:lapis_lazuli_powder') ? 10 : query.is_item_name_any('slot.weapon.offhand', 0, 'ntk:netherite_powder') ? 11 : 1) : 0]"
      ]
    }
  }
}