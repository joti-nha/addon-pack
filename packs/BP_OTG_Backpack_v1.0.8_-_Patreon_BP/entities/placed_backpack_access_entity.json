{
    "format_version": "1.20.50",
    "minecraft:entity": {
        "description": {
            "identifier": "otg:placed_backpack_access_entity",
            "is_summonable": true,
            "is_spawnable": false
        },
        "component_groups": {
            "open": {
                "minecraft:entity_sensor": {
                    "sensor_range": 2.5,
                    "relative_range": false,
                    "minimum_count": 1,
                    "event_filters": {
                        "all_of": [
                            {
                                "test": "is_family",
                                "subject": "other",
                                "value": "player"
                            },
                            {
                                "test": "has_container_open",
                                "operator": "!=",
                                "subject": "other"
                            }
                        ]
                    },
                    "event": "close"
                }
            },
            "close": {
                "minecraft:entity_sensor": {
                    "sensor_range": 2.5,
                    "relative_range": false,
                    "minimum_count": 1,
                    "event_filters": {
                        "all_of": [
                            {
                                "test": "is_family",
                                "subject": "other",
                                "value": "player"
                            },
                            {
                                "test": "has_container_open",
                                "subject": "other"
                            }
                        ]
                    },
                    "event": "open"
                }
            },
            "busy": {
                "minecraft:collision_box": {
                    "width": 0.62,
                    "height": 0.45
                }
            }
        },
        "components": {
            "minecraft:type_family": {
                "family": [
                    "backpack",
                    "otg_placed_backpack_access"
                ]
            },
            "minecraft:inventory": {
                "container_type": "minecart_chest",
                "inventory_size": 358,
                "can_be_siphoned_from": false
            },
            "minecraft:is_chested": {},
            "minecraft:persistent": {},
            "minecraft:damage_sensor": {
                "triggers": {
                    "cause": "all",
                    "deals_damage": false
                }
            },
            "minecraft:knockback_resistance": {
                "value": 1.0
            },
            "minecraft:health": {
                "value": 1000,
                "max": 1000
            },
            "minecraft:physics": {
                "has_gravity": false,
                "has_collision": false
            },
            "minecraft:collision_box": {
                "width": 0.62,
                "height": 0.45
            },
            "minecraft:pushable": {
                "is_pushable": false,
                "is_pushable_by_piston": false
            },
            "minecraft:entity_sensor": {
                "sensor_range": 2.5,
                "relative_range": false,
                "minimum_count": 1,
                "event_filters": {
                    "all_of": [
                        {
                            "test": "is_family",
                            "subject": "other",
                            "value": "player"
                        },
                        {
                            "test": "has_container_open",
                            "subject": "other"
                        }
                    ]
                },
                "event": "open"
            }
        },
        "events": {
            "open": {
                "add": {
                    "component_groups": [
                        "open"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "close"
                    ]
                },
                "queue_command": {
                    "command": "tag @s add open"
                }
            },
            "close": {
                "remove": {
                    "component_groups": [
                        "open"
                    ]
                },
                "add": {
                    "component_groups": [
                        "close"
                    ]
                },
                "queue_command": {
                    "command": "tag @s remove open"
                }
            },
            "otg:busy": {
                "add": {
                    "component_groups": [
                        "busy"
                    ]
                }
            },
            "otg:ready": {
                "remove": {
                    "component_groups": [
                        "busy"
                    ]
                }
            }
        }
    }
}