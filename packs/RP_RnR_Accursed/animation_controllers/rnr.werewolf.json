{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.rnr.werewolf.move_arms": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": ["move_arms_vanilla"],
          "transitions": [
            { "carry": "query.skin_id == 9 && query.mark_variant == 1" }
          ]
        },
        "carry": {
          "transitions": [
            { "default": "!(query.skin_id == 9 && query.mark_variant == 1)" }
          ]
        }
      }
    },
    "controller.animation.rnr.werewolf.bob": {
      "initial_state": "default",
      "states": {
        "default": {
          "animations": ["bob_vanilla"],
          "transitions": [
            { "carry": "query.skin_id == 9 && query.mark_variant == 1" }
          ]
        },
        "carry": {
          "transitions": [
            { "default": "!(query.skin_id == 9 && query.mark_variant == 1)" }
          ]
        }
      }
    }
  }
}
