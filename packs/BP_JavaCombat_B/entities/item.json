{"\u0066\u006f\u0072\u006d\u0061\u0074\u005f\u0076\u0065\u0072\u0073\u0069\u006f\u006e":"\u0031\u002e\u0032\u0031\u002e\u0039\u0030","\u006d\u0069\u006e\u0065\u0063\u0072\u0061\u0066\u0074\u003a\u0065\u006e\u0074\u0069\u0074\u0079":{"\u0064\u0065\u0073\u0063\u0072\u0069\u0070\u0074\u0069\u006f\u006e":{"\u0069\u0064\u0065\u006e\u0074\u0069\u0066\u0069\u0065\u0072":"\u006a\u0063\u003a\u0069\u0074\u0065\u006d\u005f\u0064\u0061\u006d\u0061\u0067\u0065","\u0069\u0073\u005f\u0073\u0070\u0061\u0077\u006e\u0061\u0062\u006c\u0065":false,"\u0069\u0073\u005f\u0073\u0075\u006d\u006d\u006f\u006e\u0061\u0062\u006c\u0065":true},"\u0063\u006f\u006d\u0070\u006f\u006e\u0065\u006e\u0074\u005f\u0067\u0072\u006f\u0075\u0070\u0073":{"\u0069\u0074\u0065\u006d\u003a\u0064\u0065\u0073\u0070\u0061\u0077\u006e":{"\u006d\u0069\u006e\u0065\u0063\u0072\u0061\u0066\u0074\u003a\u0069\u006e\u0073\u0074\u0061\u006e\u0074\u005f\u0064\u0065\u0073\u0070\u0061\u0077\u006e":{}}},"\u0063\u006f\u006d\u0070\u006f\u006e\u0065\u006e\u0074\u0073":{"\u006d\u0069\u006e\u0065\u0063\u0072\u0061\u0066\u0074\u003a\u0064\u0061\u006d\u0061\u0067\u0065\u005f\u0073\u0065\u006e\u0073\u006f\u0072":{"\u0074\u0072\u0069\u0067\u0067\u0065\u0072\u0073":[{"\u006f\u006e\u005f\u0064\u0061\u006d\u0061\u0067\u0065":{"\u0066\u0069\u006c\u0074\u0065\u0072\u0073":[{"\u0074\u0065\u0073\u0074":"\u0069\u0073\u005f\u0066\u0061\u006d\u0069\u006c\u0079","\u0073\u0075\u0062\u006a\u0065\u0063\u0074":"\u006f\u0074\u0068\u0065\u0072","\u0076\u0061\u006c\u0075\u0065":"\u006e\u006f\u006e\u005f\u0076\u0061\u006e\u0069\u006c\u006c\u0061\u005f\u0069\u0074\u0065\u006d\u005f\u0064\u0061\u006d\u0061\u0067\u0065"}]},"\u0063\u0061\u0075\u0073\u0065":"\u0061\u006c\u006c","\u0064\u0065\u0061\u006c\u0073\u005f\u0064\u0061\u006d\u0061\u0067\u0065":"\u0079\u0065\u0073"},{"\u0063\u0061\u0075\u0073\u0065":"\u0061\u006c\u006c","\u0064\u0065\u0061\u006c\u0073\u005f\u0064\u0061\u006d\u0061\u0067\u0065":"\u006e\u006f"}]},"\u006d\u0069\u006e\u0065\u0063\u0072\u0061\u0066\u0074\u003a\u0065\u0071\u0075\u0069\u0070\u005f\u0069\u0074\u0065\u006d":{},"\u006d\u0069\u006e\u0065\u0063\u0072\u0061\u0066\u0074\u003a\u0063\u006f\u006c\u006c\u0069\u0073\u0069\u006f\u006e\u005f\u0062\u006f\u0078":{"\u0077\u0069\u0064\u0074\u0068":1,"\u0068\u0065\u0069\u0067\u0068\u0074":1},"\u006d\u0069\u006e\u0065\u0063\u0072\u0061\u0066\u0074\u003a\u0074\u0079\u0070\u0065\u005f\u0066\u0061\u006d\u0069\u006c\u0079":{"\u0066\u0061\u006d\u0069\u006c\u0079":["\u006e\u006f\u006e\u005f\u0076\u0061\u006e\u0069\u006c\u006c\u0061\u005f\u0069\u0074\u0065\u006d\u005f\u0064\u0061\u006d\u0061\u0067\u0065"]},"\u006d\u0069\u006e\u0065\u0063\u0072\u0061\u0066\u0074\u003a\u0068\u0065\u0061\u006c\u0074\u0068":{"\u0076\u0061\u006c\u0075\u0065":1000,"\u006d\u0061\u0078":1000},"\u006d\u0069\u006e\u0065\u0063\u0072\u0061\u0066\u0074\u003a\u0061\u0074\u0074\u0061\u0063\u006b":{"\u0064\u0061\u006d\u0061\u0067\u0065":0},"\u006d\u0069\u006e\u0065\u0063\u0072\u0061\u0066\u0074\u003a\u0063\u006f\u006e\u0064\u0069\u0074\u0069\u006f\u006e\u0061\u006c\u005f\u0062\u0061\u006e\u0064\u0077\u0069\u0064\u0074\u0068\u005f\u006f\u0070\u0074\u0069\u006d\u0069\u007a\u0061\u0074\u0069\u006f\u006e":{},"\u006d\u0069\u006e\u0065\u0063\u0072\u0061\u0066\u0074\u003a\u006e\u0061\u0076\u0069\u0067\u0061\u0074\u0069\u006f\u006e\u002e\u0077\u0061\u006c\u006b":{"\u0069\u0073\u005f\u0061\u006d\u0070\u0068\u0069\u0062\u0069\u006f\u0075\u0073":true,"\u0063\u0061\u006e\u005f\u0070\u0061\u0073\u0073\u005f\u0064\u006f\u006f\u0072\u0073":true,"\u0063\u0061\u006e\u005f\u0062\u0072\u0065\u0061\u006b\u005f\u0064\u006f\u006f\u0072\u0073":true,"\u0061\u0076\u006f\u0069\u0064\u005f\u0070\u006f\u0072\u0074\u0061\u006c\u0073":false},"\u006d\u0069\u006e\u0065\u0063\u0072\u0061\u0066\u0074\u003a\u006d\u006f\u0076\u0065\u006d\u0065\u006e\u0074\u002e\u0062\u0061\u0073\u0069\u0063":{},"\u006d\u0069\u006e\u0065\u0063\u0072\u0061\u0066\u0074\u003a\u006a\u0075\u006d\u0070\u002e\u0073\u0074\u0061\u0074\u0069\u0063":{},"\u006d\u0069\u006e\u0065\u0063\u0072\u0061\u0066\u0074\u003a\u0063\u0061\u006e\u005f\u0063\u006c\u0069\u006d\u0062":{},"\u006d\u0069\u006e\u0065\u0063\u0072\u0061\u0066\u0074\u003a\u0062\u0065\u0068\u0061\u0076\u0069\u006f\u0072\u002e\u006d\u0065\u006c\u0065\u0065\u005f\u0061\u0074\u0074\u0061\u0063\u006b":{"\u0070\u0072\u0069\u006f\u0072\u0069\u0074\u0079":0,"\u006d\u0065\u006c\u0065\u0065\u005f\u0066\u006f\u0076":360,"\u0063\u006f\u006f\u006c\u0064\u006f\u0077\u006e\u005f\u0074\u0069\u006d\u0065":0.0,"\u0073\u0070\u0065\u0065\u0064\u005f\u006d\u0075\u006c\u0074\u0069\u0070\u006c\u0069\u0065\u0072":0.0,"\u0074\u0072\u0061\u0063\u006b\u005f\u0074\u0061\u0072\u0067\u0065\u0074":true,"\u0072\u0065\u0071\u0075\u0069\u0072\u0065\u005f\u0063\u006f\u006d\u0070\u006c\u0065\u0074\u0065\u005f\u0070\u0061\u0074\u0068":false,"\u0072\u0065\u0061\u0063\u0068\u005f\u006d\u0075\u006c\u0074\u0069\u0070\u006c\u0069\u0065\u0072":10,"\u0061\u0074\u0074\u0061\u0063\u006b\u005f\u006f\u006e\u0063\u0065":false,"\u0078\u005f\u006d\u0061\u0078\u005f\u0072\u006f\u0074\u0061\u0074\u0069\u006f\u006e":360,"\u0079\u005f\u006d\u0061\u0078\u005f\u0068\u0065\u0061\u0064\u005f\u0072\u006f\u0074\u0061\u0074\u0069\u006f\u006e":360,"\u0072\u0061\u006e\u0064\u006f\u006d\u005f\u0073\u0074\u006f\u0070\u005f\u0069\u006e\u0074\u0065\u0072\u0076\u0061\u006c":0},"\u006d\u0069\u006e\u0065\u0063\u0072\u0061\u0066\u0074\u003a\u0061\u0074\u0074\u0061\u0063\u006b\u005f\u0063\u006f\u006f\u006c\u0064\u006f\u0077\u006e":{"\u0061\u0074\u0074\u0061\u0063\u006b\u005f\u0063\u006f\u006f\u006c\u0064\u006f\u0077\u006e\u005f\u0074\u0069\u006d\u0065":0},"\u006d\u0069\u006e\u0065\u0063\u0072\u0061\u0066\u0074\u003a\u0072\u0069\u0064\u0065\u0061\u0062\u006c\u0065":{"\u0073\u0065\u0061\u0074\u005f\u0063\u006f\u0075\u006e\u0074":1,"\u0066\u0061\u006d\u0069\u006c\u0079\u005f\u0074\u0079\u0070\u0065\u0073":["\u006e\u006f\u006e\u005f\u0076\u0061\u006e\u0069\u006c\u006c\u0061\u005f\u0069\u0074\u0065\u006d\u005f\u0064\u0061\u006d\u0061\u0067\u0065"]},"\u006d\u0069\u006e\u0065\u0063\u0072\u0061\u0066\u0074\u003a\u0062\u0065\u0068\u0061\u0076\u0069\u006f\u0072\u002e\u006e\u0065\u0061\u0072\u0065\u0073\u0074\u005f\u0061\u0074\u0074\u0061\u0063\u006b\u0061\u0062\u006c\u0065\u005f\u0074\u0061\u0072\u0067\u0065\u0074":{"\u0061\u0074\u0074\u0061\u0063\u006b\u005f\u0069\u006e\u0074\u0065\u0072\u0076\u0061\u006c":0,"\u006d\u0075\u0073\u0074\u005f\u0073\u0065\u0065":false,"\u0070\u0072\u0069\u006f\u0072\u0069\u0074\u0079":0,"\u0065\u006e\u0074\u0069\u0074\u0079\u005f\u0074\u0079\u0070\u0065\u0073":[{"\u0066\u0069\u006c\u0074\u0065\u0072\u0073":{"\u0061\u006e\u0079\u005f\u006f\u0066":[{"\u0074\u0065\u0073\u0074":"\u0069\u0073\u005f\u0066\u0061\u006d\u0069\u006c\u0079","\u0073\u0075\u0062\u006a\u0065\u0063\u0074":"\u006f\u0074\u0068\u0065\u0072","\u0076\u0061\u006c\u0075\u0065":"\u006e\u006f\u006e\u005f\u0076\u0061\u006e\u0069\u006c\u006c\u0061\u005f\u0069\u0074\u0065\u006d\u005f\u0064\u0061\u006d\u0061\u0067\u0065"}]}}]},"\u006d\u0069\u006e\u0065\u0063\u0072\u0061\u0066\u0074\u003a\u0070\u0068\u0079\u0073\u0069\u0063\u0073":{"\u0068\u0061\u0073\u005f\u0067\u0072\u0061\u0076\u0069\u0074\u0079":false,"\u0068\u0061\u0073\u005f\u0063\u006f\u006c\u006c\u0069\u0073\u0069\u006f\u006e":false},"\u006d\u0069\u006e\u0065\u0063\u0072\u0061\u0066\u0074\u003a\u0070\u0075\u0073\u0068\u0061\u0062\u006c\u0065":{"\u0069\u0073\u005f\u0070\u0075\u0073\u0068\u0061\u0062\u006c\u0065":false,"\u0069\u0073\u005f\u0070\u0075\u0073\u0068\u0061\u0062\u006c\u0065\u005f\u0062\u0079\u005f\u0070\u0069\u0073\u0074\u006f\u006e":true},"\u006d\u0069\u006e\u0065\u0063\u0072\u0061\u0066\u0074\u003a\u0074\u0069\u006d\u0065\u0072":{"\u006c\u006f\u006f\u0070\u0069\u006e\u0067":true,"\u0074\u0069\u006d\u0065":4,"\u0074\u0069\u006d\u0065\u005f\u0064\u006f\u0077\u006e\u005f\u0065\u0076\u0065\u006e\u0074":{"\u0065\u0076\u0065\u006e\u0074":"\u0069\u0074\u0065\u006d\u003a\u0064\u0065\u0073\u0070\u0061\u0077\u006e"}}},"\u0065\u0076\u0065\u006e\u0074\u0073":{"\u0069\u0074\u0065\u006d\u003a\u0064\u0065\u0073\u0070\u0061\u0077\u006e":{"\u0061\u0064\u0064":{"\u0063\u006f\u006d\u0070\u006f\u006e\u0065\u006e\u0074\u005f\u0067\u0072\u006f\u0075\u0070\u0073":["\u0069\u0074\u0065\u006d\u003a\u0064\u0065\u0073\u0070\u0061\u0077\u006e"]}}}}}