settings.panascais_caves:reset.proceed_message=§eAre you sure you want to reset all settings to default? This action cannot be undone.
settings.panascais_caves:reset.confirm_button=§4Yes, I'm sure!
settings.panascais_caves:reset.cancel_button=§aNo, abort.
