settings.panascais_caves:information=§7Thanks for playing Eternal Caves!\n§7Use these settings to customize the add-on to your playstyle.\n\n§b- Wiki: pnsc.is/caves/wiki\n§r§d- Discord: pnsc.is/discord
settings.panascais_caves:caves.title=Caves Settings
settings.panascais_caves:caves.group.current=Current Cave
settings.panascais_caves:caves.group.vanilla=Vanilla Caves
settings.panascais_caves:caves.group.biome=Biome Caves
settings.panascais_caves:caves.group.special=Special Caves
settings.panascais_caves:color_tint.title=Biome Color Tinting
settings.panascais_caves:color_tint.explanation=§7Whether to apply a subtle color tint to the world when in a cave biome. This enhances immersion by giving each biome a unique atmosphere.\n§8(§oNote: Has no effect when playing with Vibrant Visuals)
settings.panascais_caves:distance_fog.title=Biome Distance Fog
settings.panascais_caves:distance_fog.explanation=§7Whether to apply distance fog in cave biomes. This enhances the overall atmosphere but may reduce visibility slightly.
settings.panascais_caves:particles.title=Ambience Particles
settings.panascais_caves:particles.distance=Particle Distance
settings.panascais_caves:particles.distance_explanation=§7Controls the distance at which cave particles are spawned.
settings.panascais_caves:particles.distance_tooltip=§o§cHigher values may impact performance.
settings.panascais_caves:particles.toggle_caves=Toggle Particles for Caves:
settings.panascais_caves:ambient_sounds.title=Ambient Cave Sounds
settings.panascais_caves:ambient_sounds.sound_volume=Sound Volume
settings.panascais_caves:ambient_sounds.sound_volume_explanation=§7Controls the volume of ambient background cave sounds.
settings.panascais_caves:ambient_sounds.sound_volume_tooltip=§oVolume changes take effect after a few seconds.
settings.panascais_caves:ambient_sounds.toggle_caves=Toggle Sounds for Caves:
settings.panascais_caves:random_sounds.title=Random Cave Sounds
settings.panascais_caves:random_sounds.sound_volume=Sound Volume
settings.panascais_caves:random_sounds.sound_volume_explanation=§7Controls the volume of random cave sounds.
settings.panascais_caves:random_sounds.sound_volume_tooltip=§oVolume changes take effect after a few seconds.
settings.panascais_caves:random_sounds.toggle_caves=Toggle Sounds for Caves:
settings.panascais_caves:dynamic_light.title=Dynamic Light
settings.panascais_caves:dynamic_light.explanation=§7The dynamic light system allows certain items, armors, and blocks to emit light when held or worn. Use these toggles to customize which sources can emit light.
settings.panascais_caves:dynamic_light.vanilla=Vanilla
settings.panascais_caves:dynamic_light.vanilla_tooltip=Toggles dynamic light for items, armors & blocks from vanilla Minecraft.
settings.panascais_caves:dynamic_light.caves=Eternal Caves
settings.panascais_caves:dynamic_light.caves_tooltip=Toggles dynamic light for items, armors & blocks from Eternal Caves.
settings.panascais_caves:dynamic_light.other=Other Add-Ons
settings.panascais_caves:dynamic_light.other_tooltip=Toggles dynamic light for items, armors & blocks from other add-ons that have integrated support for Eternal Caves' dynamic light system.
settings.panascais_caves:spawning.title=Mob Spawning
settings.panascais_caves:spawning.toggle_caves=Toggle Spawning for Caves:
settings.panascais_caves:spawning.spawn_quantity=Mob Spawn Quantity
settings.panascais_caves:spawning.spawn_quantity_explanation=§7Controls the maximum spawn amount of custom cave mobs. Vanilla mob spawning remains unchanged.
settings.panascais_caves:spawning.spawn_quantity_tooltip=0 = No custom cave mobs\n100 = Default spawn amount\n200 = Double spawn amount
