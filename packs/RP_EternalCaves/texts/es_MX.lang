settings.panascais_caves:color_tint.title=Tinte de color de bioma
settings.panascais_caves:color_tint.explanation=§7Determina si se aplica un tinte de color sutil al mundo cuando estás en un bioma de cueva. Esto mejora la inmersión al dar a cada bioma una atmósfera única.\n§8(§oNota: no tiene efecto al jugar con Gráficos vibrantes)
settings.panascais_caves:distance_fog.title=Niebla de distancia de bioma
settings.panascais_caves:distance_fog.explanation=§7Si se aplica niebla de distancia en los biomas de cueva. Esto mejora la atmósfera general, pero puede reducir ligeramente la visibilidad.
settings.panascais_caves:particles.title=Partículas ambientales
settings.panascais_caves:particles.distance=Distancia de partículas
settings.panascais_caves:particles.distance_explanation=§7Controla la distancia a la que aparecen las partículas de cueva.
settings.panascais_caves:particles.distance_tooltip=§o§cLos valores más altos pueden afectar el rendimiento.
settings.panascais_caves:particles.toggle_caves=Activar partículas por cueva:
settings.panascais_caves:ambient_sounds.title=Sonidos ambientales de cueva
settings.panascais_caves:ambient_sounds.sound_volume=Volumen del sonido
settings.panascais_caves:ambient_sounds.sound_volume_explanation=§7Controla el volumen de los sonidos ambientales de fondo de las cuevas.
settings.panascais_caves:ambient_sounds.sound_volume_tooltip=§oLos cambios de volumen surten efecto después de unos segundos.
settings.panascais_caves:ambient_sounds.toggle_caves=Activar sonidos por cueva:
settings.panascais_caves:random_sounds.title=Sonidos aleatorios de cueva
settings.panascais_caves:random_sounds.sound_volume=Volumen del sonido
settings.panascais_caves:random_sounds.sound_volume_explanation=§7Controla el volumen de los sonidos aleatorios de las cuevas.
settings.panascais_caves:random_sounds.sound_volume_tooltip=§oLos cambios de volumen surten efecto después de unos segundos.
settings.panascais_caves:random_sounds.toggle_caves=Activar sonidos por cueva:
settings.panascais_caves:dynamic_light.title=Luz dinámica
settings.panascais_caves:dynamic_light.explanation=§7El sistema de luz dinámica permite que ciertos objetos, armaduras y bloques emitan luz al sostenerlos o equiparlos. Usa estos interruptores para personalizar qué fuentes pueden emitir luz.
settings.panascais_caves:dynamic_light.vanilla=Vanilla
settings.panascais_caves:dynamic_light.vanilla_tooltip=Activa la luz dinámica para objetos, armaduras y bloques de Minecraft vanilla.
settings.panascais_caves:dynamic_light.caves=Eternal Caves
settings.panascais_caves:dynamic_light.caves_tooltip=Activa la luz dinámica para objetos, armaduras y bloques de Eternal Caves.
settings.panascais_caves:dynamic_light.other=Otros add-ons
settings.panascais_caves:dynamic_light.other_tooltip=Activa la luz dinámica para objetos, armaduras y bloques de otros add-ons que tengan soporte integrado para el sistema de luz dinámica de Eternal Caves.
