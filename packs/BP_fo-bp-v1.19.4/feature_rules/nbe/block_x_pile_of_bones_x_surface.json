{
  "format_version": "1.13.0",
  "minecraft:feature_rules": {
    "description": {
      "identifier": "ntk:block_x_pile_of_bones_x_surface",
      "places_feature": "ntk:nbe/block_x_pile_of_bones_x_singleblock"
    },
    "conditions": {
      "placement_pass": "after_surface_pass",
      "minecraft:biome_filter": [
        {
          "all_of": [
            {
              "test": "has_biome_tag",
              "operator": "!=",
              "value": "river"
            },
            {
              "test": "has_biome_tag",
              "operator": "!=",
              "value": "ocean"
            },
            {
              "any_of": [
                {
                  "test": "has_biome_tag",
                  "operator": "==",
                  "value": "overworld"
                }
              ]
            }
          ]
        }
      ]
    },
    "distribution": {
      "iterations": 1.0,
      "scatter_chance": 2.0,
      "x": {
        "distribution": "uniform",
        "extent": [ 0, 16 ]
      },
      "y": "query.heightmap(variable.worldx, variable.worldz)",
      "z": {
        "distribution": "uniform",
        "extent": [ 0, 16 ]
      }
    }
  }
}