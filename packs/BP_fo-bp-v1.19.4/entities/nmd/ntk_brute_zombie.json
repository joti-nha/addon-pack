// Forsaken Odyssey: breakable_blocks
{
  "format_version": "1.26.40",
  "minecraft:entity": {
    "description": {
      "identifier": "ntk:brute_zombie",
      "spawn_category": "monster",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false,
      "properties": {
        "ntk:angry_state": {
          "client_sync": true,
          "type": "enum",
          "default": "calm",
          "values": [
            "calm",
            "broadcast_anger",
            "angry"
          ]
        }
      }
    },
    "component_groups": {
      "component:brute_zombie_calm": {
        "minecraft:on_target_acquired": {
          "event": "event:on_target_acquired",
          "target": "self",
          "filters": {
            "all_of": [
              {
                "test": "enum_property",
                "domain": "ntk:angry_state",
                "subject": "self",
                "operator": "==",
                "value": "calm"
              }
            ]
          }
        }
      },
      "component:brute_zombie_angry": {
        "minecraft:angry": {
          "broadcast_targets": [
            "drowned",
            "husk",
            "zombie",
            "zombie_villager"
          ], 
          "broadcast_anger": true,
          "broadcast_anger_on_attack": true,
          "broadcast_anger_on_being_attacked": true,
          "broadcast_anger_when_dying": false,
          "broadcast_range": 20,
          "duration": 120,
          "duration_delta": 0,
          "angry_sound": "angry",
          "sound_interval": {
            "range_min": 2.0,
            "range_max": 16.0
          },
          "calm_event": {
            "event": "event:on_calm",
            "target": "self"
          },
          "broadcast_filters": {
            "all_of": [
              {
                "test": "is_tamed",
                "subject": "self",
                "operator": "==",
                "value": false
              }
            ]
          },
          "filters": {}
        },
        "minecraft:on_target_acquired": {}
      },
      "component:brute_zombie_broadcast_anger": {
        "minecraft:timer": {
          "looping": false,
          "randomInterval": false,
          "time": 1.1,
          "time_down_event": {
            "event": "event:on_timer_down",
            "target": "self"
          }
        }
      }
    },
    "components": {
      "minecraft:balloonable": {
        "mass": 1.0
      },
      "minecraft:can_climb": {},
      "minecraft:health": {
