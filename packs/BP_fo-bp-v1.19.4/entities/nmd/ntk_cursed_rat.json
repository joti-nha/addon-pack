          ]
        },
        "set_property": {
          "ntk:spawn_type": "summoned"
        }
      },
      
      "event:on_interact_with_cursed_eye": {
        "randomize": [
          {
            "weight": 50,
            "queue_command": {
              "command": [
                "playsound ominous_item_spawner.spawn_item_begin @a[r=8] ~ ~ ~ 1.0 1.3 0.0",
                "particle ntk:cursed_rat_uncursing_particle ~ ~ ~"
              ]
            },
            "add": {
              "component_groups": [
                "component:cursed_rat_uncursing_transformation_into_giant_rat"
              ]
            }
          },
          {
            "weight": 50,
            "queue_command": {
              "command": [
                "playsound ominous_item_spawner.spawn_item_begin @a[r=8] ~ ~ ~ 1.0 1.3 0.0",
                "particle ntk:cursed_rat_uncursing_particle ~ ~ ~"
              ]
            },
            "add": {
              "component_groups": [
                "component:cursed_rat_uncursing_transformation_into_rat"
              ]
            }
          }
        ]
      },
      "event:on_interact_with_incomplete_uncursing_items": {
        "queue_command": {
          "command": [
            "playsound game.player.attack.nodamage @p[r=8] ~ ~ ~ 1.0 1.1 0.0",
            "tellraw @p {\"rawtext\":[{\"text\":\"§eYou must have a §lBook of Curses§r§e in your mainhand and §lCursed Eye§r§e in your offhand to successfully uncurse the mob.§r\"}]}"
          ]
        }
      },
      
