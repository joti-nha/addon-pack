      "event:spawn_from_cursing_transformation": {
        "queue_command": {
          "command": [
            "playsound event.ntk_cursed_sound @a[r=10] ~ ~ ~ 1.0 1.0 0.0",
            "particle ntk:cursed_rat_desummoning_particle ~ ~0.15 ~",
            "particle ntk:cursed_rat_summoning_particle ~ ~0.15 ~"
          ]
        },
        "add": {
          "component_groups": [
            "component:cursed_rat_wild",
            "component:cursed_rat_despawnable"
          ]
        },
        "set_property": {
          "ntk:spawn_type": "transformation"
        }
      },
      "event:spawn_from_structure": {
        "add": {
          "component_groups": [
            "component:cursed_rat_wild",
            "component:cursed_rat_persistent"
          ]
        },
        "set_property": {
          "ntk:spawn_type": "wild"
        }
      },
      "event:spawn_from_summoning": {
