// Forsaken Odyssey: breakable_blocks
{
  "format_version": "1.26.40",
  "minecraft:entity": {
    "description": {
      "identifier": "ntk:elder_golem",
      "spawn_category": "monster",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "component_groups": {
      "component:elder_golem_health_sensor": {
        "minecraft:environment_sensor": {
          "triggers": [
            {
              "event": "event:on_environment_sensor_on_lower_health",
              "target": "self",
              "filters": {
                "all_of": [
                  {
                    "test": "actor_health",
                    "subject": "self",
                    "operator": "<=",
                    "value": 125
                  }
                ]
              }
            }
          ]
        }
			},
			"component:elder_golem_hand_attack": {
        "minecraft:behavior.melee_attack": {
          "priority": 5,
          "attack_once": false,
          "can_spread_on_fire": true,
          "require_complete_path": false,
          "track_target": true,
          "cooldown_time": 1.0,
          "min_path_time": 0.2,
          "max_path_time": 0.55,
          "path_inner_boundary": 16.0,
          "path_outer_boundary": 32.0,
          "path_fail_time_increase": 0.75,
          "inner_boundary_time_increase": 0.25,
          "outer_boundary_time_increase": 0.5,
          "random_stop_interval": 0,
          "reach_multiplier": 2.0,
          "speed_multiplier": 1.1,
          "melee_fov": 90.0,
          "x_max_rotation": 30.0,
          "y_max_head_rotation": 30.0,
          "attack_types": "",
          "on_attack": {
            "event": "event:on_attack",
            "target": "self"
          },
          "on_kill": {
            "event": "event:on_kill",
            "target": "self"
          }
        }
      },
      "component:elder_golem_stunned": {
        "minecraft:is_stunned": {},
        "minecraft:timer": {
          "looping": false,
          "randomInterval": false,
          "time": 1.0,
          "time_down_event": {
            "event": "event:on_timer_down",
            "target": "self"
          }
        }
      },
      "component:elder_golem_roar_attack": {
        "minecraft:behavior.knockback_roar": {
          "priority": 2,
          "duration": 1.0,
          "attack_time": 0.5,
          "cooldown_time": 1.5,
          "knockback_damage": 10,
          "knockback_range": 6,
          "knockback_height_cap": 0.4,
          "knockback_horizontal_strength": 4,
          "knockback_vertical_strength": 4,
          "knockback_filters": {
            "all_of": [
              {
                "test": "is_family",
                "subject": "other",
                "operator": "!=",
                "value": "golem"
              }
            ]
          },
          "damage_filters": {
            "all_of": [
              {
                "test": "is_family",
                "subject": "other",
                "operator": "!=",
                "value": "monster"
              }
            ]
          },
          "on_roar_end": {
            "event": "event:on_roar_end",
            "target": "self"
          }
        }
      }
    },
    "components": {
      "minecraft:balloonable": {
        "mass": 1.0
      },
