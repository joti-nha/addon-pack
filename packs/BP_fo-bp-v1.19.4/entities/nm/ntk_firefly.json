{
  "format_version": "1.26.40",
  "minecraft:entity": {
    "description": {
      "identifier": "ntk:firefly",
      "spawn_category": "creature",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false 
    },
    "component_groups": {},
    "components": {
      "minecraft:can_fly": {},
      "minecraft:collision_box": {
        "width": 0.4,
        "height": 0.2
      },
      "minecraft:flying_speed": {
        "value": 0.16
      },
      "minecraft:health": {
        "value": 2,
        "max": 2
      },
      "minecraft:is_hidden_when_invisible": {},
      "minecraft:movement": {
        "value": 0.3
      },
      "minecraft:scale": {
        "value": 0.6
      },
      "minecraft:type_family": {
        "family": [
          "firefly",
          "arthropod",
          "small_arthropod",
          "animal",
          "aerial",
          "mob"
        ]
      },
      
      "minecraft:breathable": {
        "breathes_air": true,
        "breathes_lava": false,
        "breathes_solids": false,
        "breathes_water": false,
        "generates_bubbles": false,
        "inhale_time": 0,
        "suffocate_time": 0,
        "total_supply": 15,
        "breathe_blocks": [],
        "non_breathe_blocks": []
      },
      "minecraft:damage_sensor": {
        "triggers": [
          {
            "cause": "fall",
            "deals_damage": "no",
						"damage_modifier": 0.0,
						"damage_multiplier": 1.0,
						"on_damage_sound_event": "",
						"on_damage": {
						  "event": "event:on_damage_sensor_fall",
						  "target": "self",
						  "filters": {}
						}
          },
          {
            "deals_damage": "no",
						"damage_modifier": 0.0,
						"damage_multiplier": 1.0,
						"on_damage_sound_event": "",
            "on_damage": {
						  "event": "event:on_damage_sensor_sweet_berry_bush",
						  "target": "self",
              "filters": {
                "all_of": [
                  {
                    "test": "is_block",
                    "subject": "block",
                    "operator": "==",
                    "value": "minecraft:sweet_berry_bush"
                  }
                ]
              }
            }
          }
        ]
      },
      "minecraft:despawn": {
        "despawn_from_chance": true,
        "despawn_from_inactivity": true,
        "despawn_from_simulation_edge": true,
        "remove_child_entities": false,
        "min_range_inactivity_timer": 30,
        "min_range_random_chance": 800,
        "despawn_from_distance": {
          "max_distance": 128,
          "min_distance": 32
        },
        "filters": {}
      },
      "minecraft:experience_reward": {
        "on_bred": "Math.Random(1,7)",
        "on_death": "query.last_hit_by_player ? Math.Random(1,1) : 0"
      },
      "minecraft:hurt_on_condition": {
        "damage_conditions": [
          {
            "cause": "lava",
            "damage_per_tick": 4,
            "filters": {
              "all_of": [
                {
                  "test": "in_lava",
                  "subject": "self",
                  "operator": "==",
                  "value": true
                }
              ]
            }
          }
        ]
      },
      "minecraft:jump.static": {
        "jump_power": 0.42
      },
      "minecraft:leashable": {
        "can_be_cut": true,
        "can_be_stolen": true,
        "on_unleash_interact_only": false,
        "unleash_on_removal": true,
        "presets": [
          {
            "spring_type": "dampened",
            "soft_distance": 4.0,
            "hard_distance": 7.0,
            "max_distance": 10.0,
            "rotation_adjustment": 0.0, 
            "filter": {}
          }
        ],
        "on_leash": {
          "event": "event:on_leash",
          "target": "self"
        },
        "on_unleash": {
          "event": "event:on_unleash",
          "target": "self"
        }
      },
      "minecraft:leashable_to": {
        "can_retrieve_from": false,
        "unleash_on_removal": true
      },
      "minecraft:movement.hover": {
        "max_turn": 30.0
      },
      "minecraft:nameable": {
        "allow_name_tag_renaming": true,
        "always_show": false,
        "default_trigger": {
          "event": "event:on_unnamed",
          "target": "self"
        },
        "name_actions": [
          {
            "name_filter": "Named",
            "on_named": {
              "event": "event:on_named",
              "target": "self"
            }
          }
        ]
      },
      "minecraft:navigation.hover": {	
        "avoid_damage_blocks": true,
        "avoid_portals": false,
        "avoid_sun": true,
        "avoid_water": true,
        "can_breach": false,
        "can_break_doors": false,
        "can_jump": true,
        "can_open_doors": false,
        "can_open_iron_doors": false,
        "can_pass_doors": true,
        "can_path_from_air": true,
        "can_path_over_lava": false,
        "can_path_over_water": true,
        "can_sink": false,
        "can_swim": false,
        "can_walk": true,
        "can_walk_in_lava": false,
        "is_amphibious": false,
        "blocks_to_avoid": [
          "minecraft:fire",
          "minecraft:flowing_lava",
          "minecraft:lava",
          "minecraft:magma",
          "minecraft:soul_fire"
        ]
      },
      "minecraft:physics": {
        "has_collision": true,
        "has_gravity": false
      },
      "minecraft:pushable_by_block": {},
      "minecraft:pushable_by_entity": {},
      
      "minecraft:behavior.float": {
        "priority": 0,
        "sink_with_passengers": false,
        "chance_per_tick_to_float": 0.8,
        "time_under_water_to_dismount_passengers": 0.0
      },
      "minecraft:behavior.panic": {
        "priority": 1,
        "force": false,
        "ignore_mob_damage": false,
        "prefer_water": false,
        "speed_multiplier": 1.1,
        "damage_sources": [
          "all"
        ]
      },
      "minecraft:behavior.avoid_block": {
        "priority": 2,
        "search_height": 2,
        "search_range": 2,
        "sprint_speed_modifier": 1.0,
        "walk_speed_modifier": 1.0,
        "tick_interval": 2,
        "avoid_block_sound": "retreat",
        "sound_interval": {
          "min": 3.0,
          "max": 8.0
        },
        "target_selection_method": "nearest",
        "target_blocks": [
          { "tags": "query.all_tags('ntk:void_block')" },
          "minecraft:fire",
          "minecraft:flowing_lava",
          "minecraft:lava",
          "minecraft:soul_fire"
        ]
      },
      "minecraft:behavior.random_hover": {
        "priority": 3,
        "hover_height": {
          "min": 1,
          "max": 4
        },
        "interval": 1,
        "xz_dist": 8,
        "y_dist": 7,
        "y_offset": 0.0,
        "speed_multiplier": 1.0
      },
      
      "minecraft:conditional_bandwidth_optimization": {
      }
    },
    "events": {
      "event:on_damage_sensor_fall": {},
			"event:on_damage_sensor_sweet_berry_bush": {},
      "event:on_leash": {},
      "event:on_named": {},
			"event:on_unleash": {},
			"event:on_unnamed": {}
    }
  }
}
