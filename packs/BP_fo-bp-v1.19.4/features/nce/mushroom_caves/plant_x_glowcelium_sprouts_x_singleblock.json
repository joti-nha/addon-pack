{
  "format_version": "1.21.40",
  "minecraft:single_block_feature": {
    "description": {
      "identifier": "ntk:nce/mushroom_caves/plant_x_glowcelium_sprouts_x_singleblock"
    },
    "places_block": [
      {
        "block": "ntk:short_glowcelium_sprouts",
        "weight": 75
      },
      {
        "block": "ntk:tall_glowcelium_sprouts",
        "weight": 100
      }
    ],
    "enforce_survivability_rules": false,
    "enforce_placement_rules": false,
    "randomize_rotation": false,
    "may_replace": [
      "minecraft:air",
      // Flower:
      "minecraft:wildflowers",
      // Plants:
      "minecraft:glow_lichen",
      "minecraft:leaf_litter",
      "minecraft:vine"
    ],
    "may_attach_to": {
      "auto_rotate": false,
      "min_sides_must_attach": 1,
			"bottom": [
        { "tags": "query.all_tags('ntk:myceliated_blocks')" },
        "minecraft:mycelium"
			]
		}
  }
}