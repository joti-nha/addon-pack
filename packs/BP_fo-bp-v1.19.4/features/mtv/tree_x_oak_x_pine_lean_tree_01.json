{
  "format_version": "1.13.0",
  "minecraft:tree_feature": {
    "description": {
      "identifier": "ntk:mtv/tree_x_oak_x_pine_lean_tree_01"
    },
    "acacia_trunk": {
      "trunk_block": "minecraft:oak_log",
      "trunk_height": {
        "base": 10, // 7, 8, 10
        "intervals": [ 2, 1 ],
        "min_height_for_canopy": 2
      },
      "trunk_width": 1,
      "trunk_lean": {
        "allow_diagonal_growth": true,
        "lean_height": {
          "range_min": 5,
          "range_max": 5
        },
        "lean_steps": {
          "range_min": 1,
          "range_max": 2
        },
        "lean_length": {
					"range_min": 1,
					"range_max": 2
				}
      }
    },
    "pine_canopy": {
      "leaf_block": "minecraft:oak_leaves",
      "base_radius": 1,
      "canopy_height": {
        "range_min": 3,
        "range_max": 5
      }
    },
    "base_block": [
      "minecraft:coarse_dirt",
      "minecraft:dirt",
      "minecraft:dirt_with_roots"
    ],
    "may_grow_on": [
      { "tags": "query.all_tags('ntk:dirt')" },
      { "tags": "query.all_tags('ntk:moss')" },
      { "tags": "query.all_tags('ntk:mud')" },
      "minecraft:clay",
      "minecraft:coarse_dirt",
      "minecraft:dirt",
      "minecraft:dirt_with_roots",
      "minecraft:farmland",
      "minecraft:grass_block",
      "minecraft:moss_block",
      "minecraft:mud",
      "minecraft:muddy_mangrove_roots",
      "minecraft:mycelium",
      "minecraft:pale_moss_block",
      "minecraft:podzol"
    ],
    "may_grow_through": [
      { "tags": "query.all_tags('ntk:dirt')" },
      { "tags": "query.all_tags('ntk:mud')" },
      "minecraft:coarse_dirt",
      "minecraft:dirt",
      "minecraft:dirt_with_roots",
      "minecraft:farmland",
      "minecraft:grass_block",
      "minecraft:mud",
      "minecraft:muddy_mangrove_roots",
      "minecraft:mycelium",
      "minecraft:podzol"
    ],
    "may_replace": [
      { "tags": "query.all_tags('ntk:environmental_block')" },
      { "tags": "query.all_tags('ntk:leaves')" },
      { "tags": "query.all_tags('ntk:plant')" },
      "minecraft:air",
      "minecraft:flowing_water",
      "minecraft:water",
      "minecraft:bush",
      "minecraft:fern",
