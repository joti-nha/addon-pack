{
  "format_version": "1.13.0",
  "minecraft:tree_feature": {
    "description": {
      "identifier": "ntk:mtv/tree_x_jungle_x_roofed_tree_01"
    },
    "acacia_trunk": {
      "trunk_block": "minecraft:jungle_log",
      "trunk_height": {
        "base": 8, // 6, 7, 8
        "intervals": [ 3, 2 ]
      },
      "trunk_width": 1,
      "trunk_lean": {
        "allow_diagonal_growth": false,
        "lean_height": {
          "range_min": 0,
          "range_max": 4
        },
        "lean_steps": {
          "range_min": 0,
          "range_max": 3
        },
        "lean_length": {
					"range_min": 1,
					"range_max": 3
				}
      },
      "trunk_decoration": {
        "decoration_block": "minecraft:vine",
        "decoration_chance": 25.0,
        "num_steps": 1,
        "step_direction": "down"
      },
      "branches": {
        "branch_chance": 33.33,
        "branch_length": {
          "range_min": 2,
          "range_max": 5
        },
        "branch_position": 1,
        "branch_canopy": {
          "acacia_canopy": {
            "leaf_block": "minecraft:jungle_leaves",
            "canopy_size": 2,
            "simplify_canopy": true
          }
        }
      }
    },
    "roofed_canopy": {
      "leaf_block": "minecraft:jungle_leaves",
      "canopy_height": 4,
      "core_width": 2,
      "outer_radius": 2,
      "inner_radius": 3
    },
    "base_block": [
      "minecraft:coarse_dirt",
      "minecraft:dirt",
      "minecraft:dirt_with_roots"
    ],
    "may_grow_on": [
      { "tags": "query.all_tags('ntk:dirt')" },
      { "tags": "query.all_tags('ntk:moss')" },
      { "tags": "query.all_tags('ntk:mud')" },
      "minecraft:clay",
      "minecraft:coarse_dirt",
      "minecraft:dirt",
      "minecraft:dirt_with_roots",
      "minecraft:farmland",
      "minecraft:grass_block",
      "minecraft:moss_block",
      "minecraft:mud",
      "minecraft:muddy_mangrove_roots",
      "minecraft:mycelium",
      "minecraft:pale_moss_block",
      "minecraft:podzol"
    ],
    "may_grow_through": [
      { "tags": "query.all_tags('ntk:dirt')" },
      { "tags": "query.all_tags('ntk:mud')" },
      "minecraft:coarse_dirt",
      "minecraft:dirt",
