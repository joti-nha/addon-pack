{
  "format_version": "1.13.0",
  "minecraft:tree_feature": {
    "description": {
      "identifier": "ntk:mtv/tree_x_mangrove_x_grove_mega_rooted_tree_01"
    },
    "mangrove_trunk": {
      "trunk_block": "minecraft:mangrove_log",
      "trunk_height": {
        "base": 9, // 7, 8, 9
        "height_rand_a": 1,
        "height_rand_b": 9
      },
      "trunk_width": 2,
      "branches": {
        "branch_chance": 100.0,
        "branch_length": {
          "range_min": 0,
          "range_max": 1
        },
        "branch_steps": {
          "range_min": 1,
          "range_max": 6
        }
      }
    },
    "mangrove_roots": {
      "root_block": "minecraft:mangrove_roots",
      "max_root_width": 10,
      "max_root_length": 16,
      "y_offset": {
        "range_min": 5,
        "range_max": 8
      },
      "mud_block": "minecraft:mud",
      "muddy_root_block": "minecraft:muddy_mangrove_roots",
      "above_root": {
        "above_root_block": "minecraft:moss_carpet",
        "above_root_chance": 50.0
      },
      "roots_may_grow_through": [
        { "tags": "query.any_tag('ntk:custom_dirt')" },
        { "tags": "query.any_tag('ntk:custom_plant', 'ntk:custom_carpet')" },
        { "tags": "query.any_tag('ntk:custom_roots')" },
        "minecraft:clay",
        "minecraft:coarse_dirt",
        "minecraft:dirt",
        "minecraft:dirt_with_roots",
        "minecraft:farmland",
        "minecraft:fern",
        "minecraft:glow_lichen",
        "minecraft:grass_block",
        "minecraft:large_fern",
        "minecraft:mangrove_propagule",
        "minecraft:mangrove_roots",
        "minecraft:moss_block",
        "minecraft:moss_carpet",
        "minecraft:mud",
        "minecraft:muddy_mangrove_roots",
        "minecraft:mycelium",
        "minecraft:pale_hanging_moss",
        "minecraft:pale_moss_block",
        "minecraft:pale_moss_carpet",
        "minecraft:podzol",
        "minecraft:short_grass",
        "minecraft:snow_layer",
        "minecraft:tall_grass",
        "minecraft:vine"
      ]
    },
    "mangrove_canopy": {
      "leaf_blocks": [
        [ "minecraft:mangrove_leaves", 1 ]
      ],
      "leaf_placement_attempts": 80,
      "canopy_height": 3,
      "canopy_radius": 4,
      "canopy_decoration": {
        "decoration_block": "minecraft:vine",
        "decoration_chance": 12.5,
        "num_steps": 2,
        "step_direction": "down"
      },
      "hanging_block": {
        "name": "minecraft:mangrove_propagule",
        "states": {
          "hanging": true
        }
      },
      "hanging_block_placement_chance": 20.0
    },
    "base_block": [
      "minecraft:mud"
    ],
    "may_replace": [
      { "tags": "query.all_tags('ntk:environmental_block')" },
      { "tags": "query.all_tags('ntk:leaves')" },
      { "tags": "query.all_tags('ntk:plant')" },
      "minecraft:air",
      "minecraft:flowing_water",
      "minecraft:water",
      "minecraft:bush",
      "minecraft:fern",
      "minecraft:firefly_bush",
      "minecraft:large_fern",
      "minecraft:seagrass",
