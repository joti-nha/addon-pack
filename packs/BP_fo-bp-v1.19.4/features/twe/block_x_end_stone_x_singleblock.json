{
  "format_version": "1.21.40",
  "minecraft:single_block_feature": {
    "description": {
      "identifier": "ntk:twe/block_x_end_stone_x_singleblock"
    },
    "places_block": [
      {
        "block": "minecraft:end_stone",
        "weight": 100
      }
    ],
    "enforce_survivability_rules": true,
    "enforce_placement_rules": false,
    "randomize_rotation": false,
    "may_replace": [
      "minecraft:air"
    ],
    "may_attach_to": {
      "auto_rotate": false,
      "min_sides_must_attach": 1,
			"bottom": [
			  { "tags": "query.all_tags('ntk:end_stone') && !query.all_tags('ntk:bryumed_blocks', 'ntk:grassed_blocks', 'ntk:mossed_blocks', 'ntk:purpurite_blocks')" },
				"minecraft:end_stone"
			]
		}
  }
}