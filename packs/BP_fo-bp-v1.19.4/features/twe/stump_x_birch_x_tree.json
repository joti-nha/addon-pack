{
  "format_version": "1.13.0",
  "minecraft:tree_feature": {
    "description": {
      "identifier": "ntk:twe/stump_x_birch_x_tree"
    },
    "trunk": {
      "trunk_block": "minecraft:birch_log",
      "trunk_height": {
        "range_min": 1,
        "range_max": 3
      },
			"height_modifier": 0.0,
      "trunk_decoration": {
        "decoration_block": "minecraft:vine",
        "decoration_chance": 10.0,
        "num_steps": 1,
        "step_direction": "down"
      }
    },
    "base_block": [
      "minecraft:coarse_dirt",
      "minecraft:dirt"
    ],
    "may_grow_on": [
      // Soil-type Blocks:
      { "tags": "query.all_tags('ntk:dirt', 'ntk:full_block')" },
      { "tags": "query.all_tags('ntk:moss', 'ntk:full_block')" },
      { "tags": "query.all_tags('ntk:mud', 'ntk:full_block')" },
      { "tags": "query.all_tags('ntk:bryumed_blocks', 'ntk:stones', 'ntk:full_block')" },
      { "tags": "query.all_tags('ntk:grassed_blocks', 'ntk:stones', 'ntk:full_block')" },
      { "tags": "query.all_tags('ntk:mossed_blocks', 'ntk:stones', 'ntk:full_block')" },
      { "tags": "query.all_tags('ntk:myceliated_blocks', 'ntk:stones', 'ntk:full_block')" },
      "minecraft:coarse_dirt",
      "minecraft:dirt",
      "minecraft:dirt_with_roots",
      "minecraft:grass_block",
      "minecraft:moss_block",
      "minecraft:mud",
      "minecraft:muddy_mangrove_roots",
      "minecraft:mycelium",
      "minecraft:pale_moss_block",
      "minecraft:podzol"
    ],
    "may_grow_through": [
      // Soil-type Blocks:
      { "tags": "query.all_tags('ntk:dirt', 'ntk:full_block')" },
      { "tags": "query.all_tags('ntk:moss', 'ntk:full_block')" },
      { "tags": "query.all_tags('ntk:mud', 'ntk:full_block')" },
      { "tags": "query.all_tags('ntk:bryumed_blocks', 'ntk:stones', 'ntk:full_block')" },
      { "tags": "query.all_tags('ntk:grassed_blocks', 'ntk:stones', 'ntk:full_block')" },
      { "tags": "query.all_tags('ntk:mossed_blocks', 'ntk:stones', 'ntk:full_block')" },
      { "tags": "query.all_tags('ntk:myceliated_blocks', 'ntk:stones', 'ntk:full_block')" },
      "minecraft:coarse_dirt",
      "minecraft:dirt",
      "minecraft:dirt_with_roots",
      "minecraft:grass_block",
      "minecraft:moss_block",
      "minecraft:mud",
      "minecraft:muddy_mangrove_roots",
      "minecraft:mycelium",
      "minecraft:pale_moss_block",
      "minecraft:podzol"
    ],
    "may_replace": [
      "minecraft:air",
      "minecraft:flowing_water",
      "minecraft:water",
      // Grasses:
      { "tags": "query.all_tags('ntk:grass')" },
      "minecraft:bush",
      "minecraft:fern",
      "minecraft:firefly_bush",
      "minecraft:large_fern",
      "minecraft:short_dry_grass",
      "minecraft:short_grass",
      "minecraft:tall_dry_grass",
      "minecraft:tall_grass",
      // Sprouts:
      { "tags": "query.all_tags('ntk:sprouts')" },
      // Flower:
      { "tags": "query.all_tags('ntk:flower')" },
      "minecraft:pink_petals",
      "minecraft:wildflowers",
      // Fungus:
      { "tags": "query.all_tags('ntk:fungus')" },
      "minecraft:brown_mushroom",
      "minecraft:red_mushroom",
      // Sapling:
      { "tags": "query.all_tags('ntk:sapling')" },
      "minecraft:azalea",
      "minecraft:flowering_azalea",
      "minecraft:mangrove_propagule",
