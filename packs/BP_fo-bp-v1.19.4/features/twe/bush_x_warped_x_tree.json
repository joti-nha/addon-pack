{
  "format_version": "1.13.0",
  "minecraft:tree_feature": {
    "description": {
      "identifier": "ntk:twe/bush_x_warped_x_tree"
    },
    "trunk": {
      "trunk_block": "minecraft:warped_stem",
      "trunk_height": 1,
      "height_modifier": 0.0,
      "can_be_submerged": {
        "max_depth": 1
      }
    },
    "canopy": {
      "leaf_block": "minecraft:warped_wart_block",
      "min_width": 0,
      "canopy_offset": {
        "min": -1,
        "max": 1
      },
      "canopy_slope": {
        "rise": 1,
        "run": 1
      },
      "variation_chance": 50.0
    },
    "base_block": [
      "minecraft:netherrack",
      "minecraft:warped_nylium"
    ],
    "may_grow_on": [
      // Soil-type Blocks:
      { "tags": "query.all_tags('ntk:soul_soil', 'ntk:full_block')" },
      "minecraft:soul_soil",
      // Nyliums:
      { "tags": "query.all_tags('ntk:crimsoned_blocks', 'ntk:full_block')" },
      { "tags": "query.all_tags('ntk:warped_blocks', 'ntk:full_block')" },
      "minecraft:crimson_nylium",
      "minecraft:warped_nylium",
      // Stone-type Blocks:
      { "tags": "query.all_tags('ntk:netherrack', 'ntk:full_block')" },
      "minecraft:netherrack"
    ],
    "may_grow_through": [
      // Soil-type Blocks:
      { "tags": "query.all_tags('ntk:soul_soil', 'ntk:full_block')" },
      "minecraft:soul_soil",
      // Nyliums:
      { "tags": "query.all_tags('ntk:crimsoned_blocks', 'ntk:full_block')" },
      { "tags": "query.all_tags('ntk:warped_blocks', 'ntk:full_block')" },
      "minecraft:crimson_nylium",
      "minecraft:warped_nylium",
      // Stone-type Blocks:
      { "tags": "query.all_tags('ntk:netherrack', 'ntk:full_block')" },
      "minecraft:netherrack"
    ],
    "may_replace": [
      "minecraft:air",
      "minecraft:fire",
      "minecraft:flowing_water",
      "minecraft:soul_fire",
      "minecraft:water",
      // Grasses:
      { "tags": "query.all_tags('ntk:grass')" },
      "minecraft:bush",
      "minecraft:fern",
      "minecraft:firefly_bush",
      "minecraft:large_fern",
      "minecraft:short_dry_grass",
      "minecraft:short_grass",
      "minecraft:tall_dry_grass",
      "minecraft:tall_grass",
      // Sprouts:
      { "tags": "query.all_tags('ntk:sprouts')" },
      "minecraft:crimson_roots",
      "minecraft:nether_sprouts",
      "minecraft:warped_roots",
      // Flowers:
      { "tags": "query.all_tags('ntk:flower')" },
      "minecraft:pink_petals",
      "minecraft:wildflowers",
      // Fungus:
      { "tags": "query.all_tags('ntk:fungus')" },
      "minecraft:brown_mushroom",
      "minecraft:crimson_fungus",
      "minecraft:red_mushroom",
      "minecraft:warped_fungus",
      // Saplings:
      { "tags": "query.all_tags('ntk:sapling')" },
      "minecraft:azalea",
      "minecraft:flowering_azalea",
      "minecraft:mangrove_propagule",
      // Crops:
      { "tags": "query.all_tags('ntk:moss_berry_bush')" },
      "minecraft:cave_vines",
      "minecraft:cave_vines_body_with_berries",
      "minecraft:cave_vines_head_with_berries",
      // Plants:
      { "tags": "query.all_tags('ntk:hanging_moss')" },
      "minecraft:big_dripleaf",
      "minecraft:glow_lichen",
      "minecraft:leaf_litter",
      "minecraft:moss_carpet",
      "minecraft:pale_hanging_moss",
      "minecraft:pale_moss_carpet",
      "minecraft:small_dripleaf_block",
      "minecraft:twisting_vines",
      "minecraft:vine",
      "minecraft:weeping_vines",
      // Leaves:
      { "tags": "query.all_tags('ntk:leaves')" },
      "minecraft:acacia_leaves",
      "minecraft:azalea_leaves",
      "minecraft:azalea_leaves_flowered",
      "minecraft:birch_leaves",
      "minecraft:cherry_leaves",
      "minecraft:dark_oak_leaves",
      "minecraft:jungle_leaves",
      "minecraft:mangrove_leaves",
      "minecraft:oak_leaves",
      "minecraft:pale_oak_leaves",
      "minecraft:spruce_leaves",
      // Environmental Blocks:
      { "tags": "query.all_tags('ntk:environmental_block')" },
      "minecraft:resin_clump",
      "minecraft:sculk_vein",
      "minecraft:snow_layer",
      "minecraft:web"
    ]
  }
}