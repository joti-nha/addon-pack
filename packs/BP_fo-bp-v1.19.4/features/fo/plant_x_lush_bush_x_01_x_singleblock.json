{
  "format_version": "1.21.40",
  "minecraft:single_block_feature": {
    "description": {
      "identifier": "ntk:fo/plant_x_lush_bush_x_01_x_singleblock"
    },
    "places_block": [
      {
        "block": "ntk:short_lush_bush",
        "weight": 100
      },
      {
        "block": "ntk:tall_lush_bush",
        "weight": 100
      }
    ],
    "enforce_survivability_rules": true,
    "enforce_placement_rules": false,
    "randomize_rotation": false,
    "may_replace": [
      { "tags": "query.any_tag('ntk:custom_sprouts')" },
      "minecraft:air",
      "minecraft:fern",
      "minecraft:large_fern",
      "minecraft:pink_petals",
      "minecraft:short_grass",
      "minecraft:tall_grass",
      "minecraft:vine",
      "minecraft:leaf_litter",
      "minecraft:short_dry_grass",
      "minecraft:tall_dry_grass",
      "minecraft:wildflowers"
    ],
    "may_attach_to": {
      "auto_rotate": false,
      "min_sides_must_attach": 1,
			"bottom": [
				{ "tags": "query.any_tag('ntk:grassed_stones', 'ntk:grassed_woods')" },
        { "tags": "query.any_tag('ntk:mossed_stones', 'ntk:mossed_woods')" },
				"minecraft:grass_block",
				"minecraft:moss_block"
			]
		}
  }
}