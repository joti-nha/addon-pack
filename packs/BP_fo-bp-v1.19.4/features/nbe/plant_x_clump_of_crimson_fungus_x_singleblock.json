{
  "format_version": "1.21.40",
  "minecraft:single_block_feature": {
    "description": {
      "identifier": "ntk:nbe/plant_x_clump_of_crimson_fungus_x_singleblock"
    },
    "places_block": [
      {
        "block": "ntk:clump_of_crimson_fungus",
        "weight": 100
      }
    ],
    "enforce_survivability_rules": false,
    "enforce_placement_rules": false,
    "randomize_rotation": true,
    "may_replace": [
      { "tags": "query.all_tags('ntk:grass')" },
      { "tags": "query.all_tags('ntk:sprouts')" },
      "minecraft:air",
      // Grass:
      "minecraft:bush",
      "minecraft:fern",
      "minecraft:firefly_bush",
      "minecraft:short_dry_grass",
      "minecraft:short_grass",
      "minecraft:tall_dry_grass",
      // Sprouts:
      "minecraft:crimson_roots",
      "minecraft:nether_sprouts",
      "minecraft:warped_roots",
      // Flowers:
      "minecraft:pink_petals",
      "minecraft:wildflowers",
      // Fungus:
      "minecraft:brown_mushroom",
      "minecraft:crimson_fungus",
      "minecraft:red_mushroom",
      "minecraft:warped_fungus",
      // Plants:
      "minecraft:glow_lichen",
      "minecraft:leaf_litter",
      "minecraft:pale_hanging_moss",
      "minecraft:vine",
      // Other:
      "minecraft:sculk_vein",
      "minecraft:snow_layer"
    ],
    "may_attach_to": {
      "auto_rotate": false,
      "min_sides_must_attach": 1,
			"bottom": [
        { "tags": "query.all_tags('ntk:netherrack')" },
        { "tags": "query.all_tags('ntk:crimsoned_blocks')" },
        { "tags": "query.all_tags('ntk:warped_blocks')" },
        // Stone-type:
        "minecraft:crimson_nylium",
        "minecraft:netherrack",
        "minecraft:warped_nylium",
        // Stems & Hyphaes:
        "minecraft:crimson_hyphae",
        "minecraft:crimson_stem",
        "minecraft:stripped_crimson_hyphae",
        "minecraft:stripped_crimson_stem",
        "minecraft:stripped_warped_hyphae",
        "minecraft:stripped_warped_stem",
        "minecraft:warped_hyphae",
        "minecraft:warped_stem"
      ]
		}
  }
}