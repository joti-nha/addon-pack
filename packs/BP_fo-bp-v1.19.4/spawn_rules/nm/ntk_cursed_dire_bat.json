{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "ntk:cursed_dire_bat",
      "population_control": "monster"
    },
    "conditions": [
      {
        "minecraft:weight": {
          "default": 10.0
        },
        "minecraft:spawns_on_surface": {},
        
        "minecraft:biome_filter": [
          {
            "all_of": [
              {
                "test": "has_biome_tag",
                "operator": "!=",
                "value": "ocean"
              },
              {
                "test": "has_biome_tag",
                "operator": "==",
                "value": "overworld"
              },
              {
                "test": "has_biome_tag",
                "operator": "==",
                "value": "monster"
              }
            ]
          }
        ],
        "minecraft:brightness_filter": {
          "adjust_for_weather": true,
          "min": 0,
          "max": 1
        },
        "minecraft:difficulty_filter": {
          "min": "easy",
          "max": "hard"
        },
        "minecraft:herd": [
          {
            "min_size": 1,
            "max_size": 2
          }
        ]
      },
      {
        "minecraft:weight": {
          "default": 10.0
        },
        "minecraft:spawns_underground": {},
        
        "minecraft:biome_filter": [
          {
            "all_of": [
              {
                "test": "has_biome_tag",
                "operator": "==",
                "value": "overworld"
              },
              {
                "test": "has_biome_tag",
                "operator": "==",
                "value": "monster"
              }
            ]
          }
        ],
        "minecraft:brightness_filter": {
          "adjust_for_weather": true,
          "min": 0,
          "max": 1
        },
        "minecraft:difficulty_filter": {
          "min": "easy",
          "max": "hard"
        },
        "minecraft:herd": [
          {
            "min_size": 1,
            "max_size": 2
          }
        ]
      }
    ]
  }
}