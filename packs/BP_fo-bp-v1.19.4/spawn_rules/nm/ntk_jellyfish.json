{
  "format_version": "1.8.0",
  "minecraft:spawn_rules": {
    "description": {
      "identifier": "ntk:jellyfish",
      "population_control": "water_animal"
    },
    "conditions": [
      {
        "minecraft:weight": {
          "default": 25.0
        },
        "minecraft:spawns_on_surface": {},
        "minecraft:spawns_underwater": {},
        
        "minecraft:biome_filter": [
          {
            "all_of": [
              { 
                "test": "has_biome_tag",
                "operator": "==",
                "value": "ocean"
              },
              { 
                "test": "has_biome_tag",
                "operator": "!=",
                "value": "warm"
              },
              { 
                "test": "has_biome_tag",
                "operator": "!=",
                "value": "lukewarm"
              }
            ]
          }
        ],
        "minecraft:brightness_filter": {
