{
	"format_version": "1.10.0",
	"particle_effect": {
		"description": {
			"identifier": "tm_aqc:bad_stew",
			"basic_render_parameters": {
				"material": "particles_blend",
				"texture": "textures/particle/particles"
			}
		},
		"components": {
			"minecraft:emitter_rate_instant": {
				"num_particles": "math.random(10,25)"
			},
			"minecraft:emitter_lifetime_once": {
				"active_time": 1
			},
			"minecraft:emitter_shape_point": {
				"direction": ["math.random(-5,5)", "math.random(10,20)", "math.random(-5,5)"]
			},
			"minecraft:particle_lifetime_expression": {
				"max_lifetime": 1
			},
			"minecraft:particle_expire_if_not_in_blocks": ["minecraft:air", "tm_aqc:stew_pot"],
			"minecraft:particle_initial_speed": "math.random(1,3)",
			"minecraft:particle_motion_dynamic": {
				"linear_acceleration": [0, -4, 0]
			},
			"minecraft:particle_appearance_billboard": {
				"size": [0.05, 0.05],
				"facing_camera_mode": "rotate_xyz",
				"uv": {
					"texture_width": 128,
					"texture_height": 128,
					"flipbook": {
						"base_UV": [64, 64],
						"size_UV": [8, 8],
						"step_UV": [-8, 0],
						"frames_per_second": 10,
						"max_frame": 8
					}
				}
			},
			"minecraft:particle_appearance_tinting": {
				"color": {
					"interpolant": "v.particle_age / v.particle_lifetime",
					"gradient": {
						"0.0": "#FF665F70",
						"1.0": "#FF302B38"
					}
				}
			}
		}
	}
}