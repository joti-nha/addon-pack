{
	"format_version": "1.10.0",
	"animation_controllers": {
		"controller.animation.tm_aqc.rod.attachable": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": [
						{"first_person_hold_main_hand": "c.item_slot == 'main_hand'"},
						{"first_person_hold_off_hand": "c.item_slot == 'off_hand'"}
					],
					"transitions": [
						{"third_person": "!c.is_first_person"}
					]
				},
				"third_person": {
					"animations": [
						{"third_person_hold_main_hand": "c.item_slot == 'main_hand'"},
						{"third_person_hold_off_hand": "c.item_slot == 'off_hand'"}
					],
					"transitions": [
						{"default": "c.is_first_person"}
					]
				}
			}
		},
		"controller.animation.tm_aqc.rod.use": {
			"states": {
				"default": {
					"transitions": [
						{"use": "t.cast == 1 && c.is_first_person"}
					]
				},
				"use": {
					"animations": ["first_person_use"],
					"transitions": [
						{"reel": "t.cast == 0"}
					]
				},
				"reel": {
					"animations": ["first_person_use"],
					"transitions": [
						{"default": "query.all_animations_finished"}
					]
				}
			}
		}
	}
}