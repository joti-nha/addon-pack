{
  "format_version": "1.21.30",
  "minecraft:attachable": {
    "description": {
      "identifier": "tm_aqc:scale_leggings",
      "item": { "tm_aqc:scale_leggings": "query.owner_identifier != 'minecraft:player'" },
      "materials": {
        "default": "armor",
        "dyed": "entity_alphatest_change_color",
        "enchanted": "armor_enchanted"
      },
      "textures": {
        "default": "textures/tm/aqc/models/armor/scale_2",
        "dyed": "textures/tm/aqc/models/armor/scale_2_dyed",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.player.armor.leggings"
      },
      "scripts": {
        "pre_animation": [
          "variable.is_dyed = query.armor_color_slot(2, 0) != 1.0 || query.armor_color_slot(2, 1) != 1.0 || query.armor_color_slot(2, 2) != 1.0;"
        ],
        "parent_setup": "variable.chest_layer_visible = 0.0;"
      },
      "render_controllers": [ "controller.render.tm_aqc.custom_armor" ]
    }
  }
}
