{
  "format_version": "1.21.30",
  "minecraft:attachable": {
    "description": {
      "identifier": "tm_aqc:scale_helmet",
      "item": { "tm_aqc:scale_helmet": "query.owner_identifier != 'minecraft:player'" },
      "materials": {
        "default": "armor",
        "dyed": "entity_alphatest_change_color",
        "enchanted": "armor_enchanted"
      },
      "textures": {
        "default": "textures/tm/aqc/models/armor/scale_1",
        "dyed": "textures/tm/aqc/models/armor/scale_1_dyed",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.player.armor.helmet"
      },
      "scripts": {
        "pre_animation": [
          "variable.is_dyed = query.armor_color_slot(0, 0) != 1.0 || query.armor_color_slot(0, 1) != 1.0 || query.armor_color_slot(0, 2) != 1.0;"
        ],
        "parent_setup": "variable.chest_layer_visible = 0.0;"
      },
      "render_controllers": [ "controller.render.tm_aqc.custom_armor" ]
    }
  }
}
