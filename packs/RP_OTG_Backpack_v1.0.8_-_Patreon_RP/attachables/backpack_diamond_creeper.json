{
    "format_version": "1.10.0",
    "minecraft:attachable": {
        "description": {
            "identifier": "otg:backpack_diamond_creeper",
            "materials": {
                "default": "entity_alphatest"
            },
            "textures": {
                "default": "textures/entity/attachable/backpack_creeper"
            },
            "geometry": {
                "default": "geometry.creeper_backpack",
                "offhand": "geometry.creeper_backpack",
                "mainhand": "geometry.creeper_backpack_mainhand"
            },
            "render_controllers": [
                "controller.render.backpack_dynamic"
            ],
            "animations": {
                "offhand_first": "animation.creeper_backpack.first_person_hold",
                "offhand_third": "animation.creeper_backpack.third_person_hold",
                "mainhand_first": "animation.creeper_backpack_mainhand.first_person_hold",
                "mainhand_third": "animation.creeper_backpack_mainhand.third_person_hold"
            },
            "scripts": {
                "animate": [
                    {
                        "offhand_first": "c.item_slot == 'off_hand' && c.is_first_person"
                    },
                    {
                        "offhand_third": "c.item_slot == 'off_hand' && !c.is_first_person"
                    },
                    {
                        "mainhand_first": "c.item_slot == 'main_hand' && c.is_first_person"
                    },
                    {
                        "mainhand_third": "c.item_slot == 'main_hand' && !c.is_first_person"
                    }
                ]
            }
        }
    }
}