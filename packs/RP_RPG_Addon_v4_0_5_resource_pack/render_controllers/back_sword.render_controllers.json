{
  "format_version": "1.8.0",
  "render_controllers": {
    "controller.render.player_back_sword": {
      "arrays": {
        "textures": {
          "Array.sword_textures": [
            "Texture.sword_wood",
            "Texture.sword_wood",
            "Texture.sword_stone",
            "Texture.sword_iron",
            "Texture.sword_gold",
            "Texture.sword_diamond",
            "Texture.sword_netherite"
          ]
        }
      },
      "geometry": "Geometry.back_sword",
      "materials": [
        {
          "*": "query.property('rpg:sword_enchanted') ? Material.glint : Material.default"
        }
      ],
      "textures": [
        "Array.sword_textures[query.property('rpg:back_sword')]",
        "Texture.enchanted"
      ]
    }
  }
}
