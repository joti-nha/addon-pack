{
	"format_version": "1.20.80",
	"minecraft:entity": {
		"description": {
			"identifier": "mnra_cata:cosmic_spirit",
			"is_spawnable": true,
			"is_summonable": true,
			"is_experimental": false
		},
		"component_groups": {
			"interactable": {
				"minecraft:interact": {
					"interactions": {
						"on_interact": {
							"event": "start_trade",
							"filters": {
								"all_of": [
									{
										"test": "is_family",
										"subject": "other",
										"value": "player"
									},
									{
										"test": "has_equipment",
										"subject": "other",
										"value": "mnra_cata:starfall"
									}
								]
							}
						},
						"swing": true,
						"use_item": true,
						"transform_to_item": "minecraft:air",
						"take_item": true,
						"play_sounds": "trade",
						"cooldown_after_being_attacked": 5,
						"cooldown": 30,
						"vibration": "entity_interact"
					}
				}
			},
			"trading": {
				"minecraft:skin_id": {
					"value": 1
				}
			},
			"trade_timer": {
				"minecraft:timer": {
					"looping": true,
					"time": [
						4.5,
						4.5
					],
					"time_down_event": {
						"event": "final_trade"
					}
				}
			},
			"has_nothing": {
				"minecraft:skin_id": {
					"value": 0
				}
			}
		},
		"components": {
			"minecraft:health": {
				"value": 5,
				"max": 5
			},
			"minecraft:type_family": {
				"family": [
					"mob",
					"cosmic_spirit",
					"astral"
				]
			},
			"minecraft:collision_box": {
				"width": 0.4,
				"height": 0.6
			},
			"minecraft:physics": {
				"has_collision": true,
				"has_gravity": false
			},
			"minecraft:movement": {
				"value": 0.1
			},
			"minecraft:can_climb": {},
			"minecraft:behavior.look_at_player": {
				"priority": 6,
				"probability": 0.02,
				"look_distance": 8
			},
			"minecraft:pushable": {
				"is_pushable": true,
				"is_pushable_by_piston": true
			},
			"minecraft:behavior.random_stroll": {
				"priority": 5
			},
			"minecraft:navigation.hover": {
				"avoid_powder_snow": true,
				"avoid_portals": true,
				"avoid_damage_blocks": true,
				"can_open_doors": true,
				"can_open_iron_doors": true,
				"can_pass_doors": true,
				"can_path_over_water": true,
				"can_path_over_lava": true,
				"avoid_water": true,
				"can_path_from_air": true
			},
			"minecraft:knockback_resistance": {
				"value": 0.1
			},
			"minecraft:flying_speed": {
				"value": 0.18
			},
			"minecraft:behavior.hover": {
				"priority": 5
			},
			"minecraft:can_fly": {},
			"minecraft:game_event_movement_tracking": {
				"emit_flap": true
			},
			"minecraft:behavior.float": {
				"priority": 5
			},
			"minecraft:behavior.random_hover": {
				"priority": 4,
				"xz_dist": 5,
				"y_dist": 1,
				"y_offset": -1,
				"interval": 120,
				"hover_height": [
					1,
					2
				]
			},
			"minecraft:movement.hover": {},
			"minecraft:scale": {
				"value": 1.1
			},
			"minecraft:behavior.tempt": {
				"priority": 1,
				"within_radius": 12,
				"speed_multiplier": 1,
				"items": [
					"mnra_cata:starfall"
				],
				"can_tempt_vertically": true,
				"can_get_scared": false
			},
			"minecraft:home": {
				"restriction_radius": 24,
				"home_block_list": [
					"mnra_cata:asteroid",
					"mnra_cata:polished_asteroid"
				]
			},
			"minecraft:jump.static": {},
			"minecraft:conditional_bandwidth_optimization": {},
			"minecraft:damage_sensor": {
				"triggers": [
					{
						"cause": "fall",
						"deals_damage": false
					},
					{
						"cause": "suffocation",
						"deals_damage": false
					}
				]
			},
			"minecraft:annotation.open_door": {},
			"minecraft:behavior.go_home": {
				"priority": 0,
				"speed_multiplier": 1.5,
				"goal_radius": 4,
				"interval": 120,
				"calculate_new_path_radius": 2
			}
		},
		"events": {
			"start_trade": {
				"add": {
					"component_groups": [
						"trading",
						"trade_timer"
					]
				},
				"remove": {
					"component_groups": [
						"has_nothing"
					]
				},
				"queue_command": {
					"command": [
						"playsound mob.allay.item_given @a[r=8] ~ ~ ~ 1.5 1.1 1"
					]
				}
			},
			"final_trade": {
				"remove": {
					"component_groups": [
						"trading",
						"trade_timer"
					]
				},
				"add": {
					"component_groups": [
						"has_nothing"
					]
				},
				"queue_command": {
					"command": [
						"loot spawn ~~1~ loot \"minera/cata/entities/cosmic_spirit.trade\"",
						"playsound mob.allay.item_taken @a[r=8] ~ ~ ~ 1.5 1.1 1",
						"execute at @s as @a[tag=mnra_cata:twilight_necklace, r=24] run loot spawn ~~1~ loot \"minera/cata/entities/cosmic_spirit.trade\""
					]
				}
			},
			"minecraft:entity_spawned": {
				"add": {
					"component_groups": [
						"interactable"
					]
				}
			}
		}
	}
}