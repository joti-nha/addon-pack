{
	"format_version": "1.10.0",
	"minecraft:attachable": {
		"description": {
			"identifier": "dungeons:glaive",
			"render_controllers": ["controller.render.item_default"],
			"materials": {
				"default": "entity_alphatest",
				"enchanted": "entity_alphatest_glint"
			}, /**/
			"textures": {
				"default": "textures/items/weapon/glaive",
				"enchanted": "textures/misc/enchanted_item_glint"
			},
			"geometry": {
				"default": "geometry.glaive"
			},
			"animations": {
				"first_person_hold": "animation.glaive.first_person_hold",
				"third_person_hold": "animation.glaive.third_person_hold"
			},
			"scripts": {
				"parent_setup": "c.item_slot == 'main_hand' ? { v.oreville_mainhand_visible = 1; v.oreville_mainhand_custom_pos = 1; } : c.item_slot == 'off_hand' ? { v.oreville_offhand_visible = 1; } : 0;",
				"animate": [
					{
						"first_person_hold": "c.is_first_person"
					},
					{
						"third_person_hold": "!c.is_first_person"
					}
				]
			}
		}
	}
}