{
  "format_version": "1.21.80",
  "minecraft:attachable": {
    "description": {
      "identifier": "dungeons:totem_of_casting",
      "item": {
        "dungeons:totem_of_casting": "c.owning_entity -> v.actions_and_stuff;"
      },
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/items/artifact/totem_casting",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.sprite"
      },
      "animations": {
        "cast_fp": "animation.unified.artifact_cast_fp",
        "cast_tp": "animation.unified.artifact_cast_tp"
      },
      "scripts": {
        "pre_animation": [
          "v.art_swing = c.owning_entity -> v.attack_time;"
        ],
        "animate": [
          {
            "cast_fp": "c.is_first_person && v.art_swing > 0"
          },
          {
            "cast_tp": "!c.is_first_person && v.art_swing > 0"
          }
        ],
        "parent_setup": "c.item_slot == 'main_hand' ? { v.oreville_mainhand_visible = 1; v.oreville_mainhand_custom_pos = 1; } : c.item_slot == 'off_hand' ? { v.oreville_offhand_visible = 1; } : 0;"
      },
      "render_controllers": [
        "controller.render.item_sprite"
      ]
    }
  }
}