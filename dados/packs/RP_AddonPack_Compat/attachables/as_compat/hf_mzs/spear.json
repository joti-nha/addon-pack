{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "hf_mzs:spear",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/hf/mzs/attachable/spear",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.hf_mzs.spear"
      },
      "animations": {
        "fp_idle": "animation.hf_mzs.spear.fp_hold",
        "tp_idle": "animation.hf_mzs.spear.tp_hold"
      },
      "scripts": {
        "animate": [
          {
            "fp_idle": "c.is_first_person"
          },
          {
            "tp_idle": "!c.is_first_person"
          }
        ],
        "parent_setup": "c.item_slot == 'main_hand' ? { v.oreville_mainhand_visible = 1; v.oreville_mainhand_custom_pos = 1; } : c.item_slot == 'off_hand' ? { v.oreville_offhand_visible = 1; } : 0;"
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}