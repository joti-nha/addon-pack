{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "hf_mzs:sculptor_staff",
      "materials": {
        "default": "entity_alphatest",
        "enchanted": "entity_alphatest_glint"
      },
      "textures": {
        "default": "textures/hf/mzs/attachable/sculptor_staff",
        "enchanted": "textures/misc/enchanted_item_glint"
      },
      "geometry": {
        "default": "geometry.hf_mzs.sculptor_staff"
      },
      "animations": {
        "first_person": "animation.hf_mzs.sculptor_staff.first_person",
        "third_person": "animation.hf_mzs.sculptor_staff.third_person"
      },
      "scripts": {
        "animate": [
          {
            "first_person": "c.is_first_person"
          },
          {
            "third_person": "!c.is_first_person"
          }
        ],
        "parent_setup": "c.item_slot == 'main_hand' ? { v.oreville_mainhand_visible = 1; v.oreville_mainhand_custom_pos = 1; } : c.item_slot == 'off_hand' ? { v.oreville_offhand_visible = 1; } : 0;"
      },
      "render_controllers": [
        "controller.render.item_default"
      ]
    }
  }
}