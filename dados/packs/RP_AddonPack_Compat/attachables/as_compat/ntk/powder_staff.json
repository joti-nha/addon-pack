{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "ntk:powder_staff",
      "item": {
        "ntk:powder_staff": "query.get_equipped_item_name('main_hand') == 'powder_staff'"
      },
      "render_controllers": [
        "controller.render.item.ntk_powder_staff"
      ],
      "geometry": {
        "default": "geometry.item.ntk_powder_staff"
      },
      "materials": {
        "default": "ntk_item_emissive_nocull_alpha",
        "enchanted": "ntk_item_emissive_nocull_alpha"
      },
      "textures": {
        "powder_staff_uncharged": "textures/models/nie/ntk_powder_staff_uncharged",
        "powder_staff_charged": "textures/models/nie/ntk_powder_staff_charged",
        "amethyst_powder_staff": "textures/models/nie/ntk_amethyst_powder_staff",
        "charcoal_powder_staff": "textures/models/nie/ntk_charcoal_powder_staff",
        "copper_powder_staff": "textures/models/nie/ntk_copper_powder_staff",
        "diamond_powder_staff": "textures/models/nie/ntk_diamond_powder_staff",
        "emerald_powder_staff": "textures/models/nie/ntk_emerald_powder_staff",
        "enchanted_powder_staff": "textures/models/nie/ntk_enchanted_powder_staff",
        "gold_powder_staff": "textures/models/nie/ntk_gold_powder_staff",
        "iron_powder_staff": "textures/models/nie/ntk_iron_powder_staff",
        "lapis_lazuli_powder_staff": "textures/models/nie/ntk_lapis_lazuli_powder_staff",
        "netherite_powder_staff": "textures/models/nie/ntk_netherite_powder_staff"
      },
      "sound_effects": {
        "charging": "item.ntk_staff.charging"
      },
      "animations": {
        "controller_wield": "controller.animation.item.ntk_powder_staff.wield",
        "1st_person_wield": "animation.item.ntk_powder_staff.1st_person_wield",
        "1st_person_wield_charging": "animation.item.ntk_powder_staff.1st_person_wield_charging",
        "1st_person_wield_charged": "animation.item.ntk_powder_staff.1st_person_wield_charged",
        "3rd_person_wield": "animation.item.ntk_powder_staff.3rd_person_wield",
        "3rd_person_wield_charging": "animation.item.ntk_powder_staff.3rd_person_wield_charging",
        "3rd_person_wield_charged": "animation.item.ntk_powder_staff.3rd_person_wield_charged",
        "staff_animation": "animation.item.ntk_powder_staff.staff_animation"
      },
      "scripts": {
        "should_update_bones_and_effects_offscreen": true,
        "animate": [
          "controller_wield",
          "staff_animation"
        ],
        "parent_setup": "c.item_slot == 'main_hand' ? { v.oreville_mainhand_visible = 1; v.oreville_mainhand_custom_pos = 1; } : c.item_slot == 'off_hand' ? { v.oreville_offhand_visible = 1; } : 0;"
      }
    }
  }
}