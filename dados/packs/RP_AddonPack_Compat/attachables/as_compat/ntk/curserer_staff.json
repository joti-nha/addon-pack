{
  "format_version": "1.26.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "ntk:curserer_staff",
      "item": {
        "ntk:curserer_staff": "query.get_equipped_item_name('main_hand') == 'curserer_staff'"
      },
      "render_controllers": [
        "controller.render.item.ntk_curserer_staff"
      ],
      "geometry": {
        "default": "geometry.item.ntk_curserer_staff"
      },
      "materials": {
        "default": "ntk_item_emissive_nocull_alpha",
        "enchanted": "ntk_item_emissive_nocull_alpha"
      },
      "textures": {
        "default": "textures/models/nmd/ntk_curserer_staff",
        "enchanted": "textures/models/nmd/ntk_curserer_staff"
      },
      "animations": {
        "controller_wield": "controller.animation.item.ntk_curserer_staff.wield",
        "staff_animation": "animation.item.ntk_curserer_staff.staff_animation",
        "wield_first_person": "animation.item.ntk_curserer_staff.wield_first_person",
        "wield_third_person": "animation.item.ntk_curserer_staff.wield_third_person"
      },
      "scripts": {
        "should_update_bones_and_effects_offscreen": true,
        "animate": [
          "controller_wield",
          "staff_animation"
        ],
        "parent_setup": "c.item_slot == 'main_hand' ? { v.oreville_mainhand_visible = 1; v.oreville_mainhand_custom_pos = 1; } : c.item_slot == 'off_hand' ? { v.oreville_offhand_visible = 1; } : 0;"
      }
    }
  }
}