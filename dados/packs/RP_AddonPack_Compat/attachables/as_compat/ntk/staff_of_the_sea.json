{
  "format_version": "1.10.0",
  "minecraft:attachable": {
    "description": {
      "identifier": "ntk:staff_of_the_sea",
      "item": {
        "ntk:staff_of_the_sea": "query.get_equipped_item_name('main_hand') == 'staff_of_the_sea'"
      },
      "render_controllers": [
        "controller.render.item.ntk_staff_of_the_sea"
      ],
      "geometry": {
        "default": "geometry.item.ntk_staff_of_the_sea"
      },
      "materials": {
        "default": "ntk_item_emissive_nocull_alpha",
        "enchanted": "ntk_item_emissive_nocull_alpha"
      },
      "textures": {
        "inactive_staff_of_the_sea": "textures/models/nie/ntk_staff_of_the_sea_inactive",
        "active_staff_of_the_sea": "textures/models/nie/ntk_staff_of_the_sea_active"
      },
      "animations": {
        "controller_wield": "controller.animation.item.ntk_staff_of_the_sea.wield",
        "1st_person_wield": "animation.item.ntk_staff_of_the_sea.1st_person_wield",
        "3rd_person_wield": "animation.item.ntk_staff_of_the_sea.3rd_person_wield",
        "staff_animation": "animation.item.ntk_staff_of_the_sea.staff_animation"
      },
      "scripts": {
        "should_update_bones_and_effects_offscreen": true,
        "animate": [
          "controller_wield",
          {
            "staff_animation": "query.is_in_water"
          }
        ],
        "parent_setup": "c.item_slot == 'main_hand' ? { v.oreville_mainhand_visible = 1; v.oreville_mainhand_custom_pos = 1; } : c.item_slot == 'off_hand' ? { v.oreville_offhand_visible = 1; } : 0;"
      }
    }
  }
}